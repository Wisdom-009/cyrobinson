          "_name": "menu05",
          "_sourceTheme": "startm5",
          "_customHTML": "```html\n<style>\n/* =====================================\n   CY ROBINSON TECHNOLOGIES\n   FULL-WIDTH GREEN NAVIGATION\n===================================== */\n\nsection.cyr-menu {\n  position: relative !important;\n  z-index: 9999 !important;\n  width: 100% !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  background: #0B120D !important;\n}\n\nsection.cyr-menu nav.navbar {\n  width: 100% !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  background: transparent !important;\n  box-shadow: none !important;\n}\n\nsection.cyr-menu nav.navbar > .container {\n  width: 100% !important;\n  max-width: 100% !important;\n  min-height: 100px !important;\n  margin: 0 auto !important;\n  padding: 15px 6% !important;\n  display: flex !important;\n  align-items: center !important;\n  justify-content: space-between !important;\n  flex-wrap: nowrap !important;\n  background: linear-gradient(105deg,#0B120D 0%,#111A13 55%,#162218 100%) !important;\n  border: 0 !important;\n  border-bottom: 1px solid rgba(197,237,121,0.16) !important;\n  border-radius: 0 !important;\n  box-shadow: 0 8px 28px rgba(0,0,0,0.20) !important;\n  box-sizing: border-box !important;\n}\n\n/* LOGO AND BRAND NAME */\n\nsection.cyr-menu .navbar-brand {\n  margin: 0 !important;\n  padding: 0 !important;\n  display: flex !important;\n  align-items: center !important;\n  flex-shrink: 0 !important;\n}\n\nsection.cyr-menu .navbar-caption-wrap {\n  padding: 0 !important;\n}\n\nsection.cyr-menu a.cyr-logo {\n  display: inline-flex !important;\n  align-items: center !important;\n  gap: 14px !important;\n  padding: 0 !important;\n  margin: 0 !important;\n  text-decoration: none !important;\n  background: transparent !important;\n  line-height: 1 !important;\n}\n\nsection.cyr-menu .cyr-logo-image {\n  display: block !important;\n  width: 65px !important;\n  height: 65px !important;\n  object-fit: contain !important;\n  object-position: center !important;\n  flex-shrink: 0 !important;\n}\n\nsection.cyr-menu .cyr-brand-name {\n  display: block !important;\n  color: #ffffff !important;\n  font-family: Arial, sans-serif !important;\n  font-size: 15px !important;\n  font-weight: 800 !important;\n  letter-spacing: 1.8px !important;\n  line-height: 1.4 !important;\n  white-space: nowrap !important;\n}\n\n/* NAVIGATION LINKS */\n\nsection.cyr-menu .navbar-collapse {\n  align-items: center !important;\n  justify-content: flex-end !important;\n}\n\nsection.cyr-menu ul.navbar-nav {\n  display: flex !important;\n  align-items: center !important;\n  gap: 12px !important;\n  margin: 0 32px 0 auto !important;\n  padding: 0 !important;\n}\n\nsection.cyr-menu ul.navbar-nav li {\n  margin: 0 !important;\n  padding: 0 !important;\n}\n\nsection.cyr-menu a.cyr-link {\n  display: inline-block !important;\n  padding: 13px 16px !important;\n  border-radius: 8px !important;\n  color: #B5C0B0 !important;\n  font-family: Arial,sans-serif !important;\n  font-size: 13px !important;\n  font-weight: 500 !important;\n  text-decoration: none !important;\n  background: transparent !important;\n  transition: all .25s ease !important;\n}\n\nsection.cyr-menu a.cyr-link:hover {\n  color: #D0EF78 !important;\n  background: rgba(183,230,92,0.10) !important;\n}\n\n/* PROJECT BUTTON */\n\nsection.cyr-menu .navbar-buttons {\n  margin: 0 !important;\n  padding: 0 !important;\n}\n\nsection.cyr-menu a.cyr-project-btn {\n  min-height: 49px !important;\n  padding: 0 24px !important;\n  display: inline-flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  gap: 13px !important;\n  border: 1px solid rgba(197,237,121,0.25) !important;\n  border-radius: 9px !important;\n  background: linear-gradient(110deg,#A6D84D,#D0EF78) !important;\n  color: #14200F !important;\n  font-family: Arial,sans-serif !important;\n  font-size: 12px !important;\n  font-weight: 800 !important;\n  text-decoration: none !important;\n  box-shadow: 0 7px 22px rgba(143,191,77,0.17) !important;\n  transition: all .25s ease !important;\n}\n\nsection.cyr-menu a.cyr-project-btn span {\n  color: #14200F !important;\n  font-size: 18px !important;\n}\n\nsection.cyr-menu a.cyr-project-btn:hover {\n  color: #14200F !important;\n  transform: translateY(-2px) !important;\n  box-shadow: 0 10px 28px rgba(183,230,92,0.27) !important;\n}\n\n/* MOBILE MENU BUTTON */\n\nsection.cyr-menu button.navbar-toggler {\n  display: none;\n  padding: 11px !important;\n  border: 1px solid rgba(197,237,121,0.22) !important;\n  border-radius: 9px !important;\n  background: rgba(183,230,92,0.07) !important;\n  box-shadow: none !important;\n}\n\nsection.cyr-menu .hamburger {\n  width: 23px !important;\n  height: 18px !important;\n  display: flex !important;\n  flex-direction: column !important;\n  justify-content: space-between !important;\n}\n\nsection.cyr-menu .hamburger span {\n  display: block !important;\n  width: 100% !important;\n  height: 2px !important;\n  border-radius: 5px !important;\n  background: #C5ED79 !important;\n}\n\n/* TABLET AND MOBILE */\n\n@media (max-width: 991px) {\n  section.cyr-menu nav.navbar > .container {\n    min-height: 82px !important;\n    padding: 12px 5% !important;\n    flex-wrap: wrap !important;\n  }\n\n  section.cyr-menu .cyr-logo-image {\n    width: 55px !important;\n    height: 55px !important;\n  }\n\n  section.cyr-menu .cyr-brand-name {\n    font-size: 13px !important;\n    letter-spacing: 1.2px !important;\n  }\n\n  section.cyr-menu button.navbar-toggler {\n    display: flex !important;\n    margin-left: auto !important;\n  }\n\n  section.cyr-menu .navbar-collapse {\n    width: 100% !important;\n    flex-basis: 100% !important;\n    margin-top: 13px !important;\n    padding: 14px 5px 5px !important;\n    border-top: 1px solid rgba(197,237,121,0.13) !important;\n  }\n\n  section.cyr-menu ul.navbar-nav {\n    width: 100% !important;\n    margin: 0 !important;\n    display: flex !important;\n    flex-direction: column !important;\n    align-items: stretch !important;\n    gap: 3px !important;\n  }\n\n  section.cyr-menu a.cyr-link {\n    display: block !important;\n    width: 100% !important;\n    padding: 13px 12px !important;\n  }\n\n  section.cyr-menu .navbar-buttons {\n    width: 100% !important;\n    margin-top: 12px !important;\n  }\n\n  section.cyr-menu a.cyr-project-btn {\n    width: 100% !important;\n  }\n}\n\n@media (max-width: 480px) {\n  section.cyr-menu nav.navbar > .container {\n    min-height: 74px !important;\n    padding: 9px 4% !important;\n  }\n\n  section.cyr-menu a.cyr-logo {\n    gap: 9px !important;\n  }\n\n  section.cyr-menu .cyr-logo-image {\n    width: 45px !important;\n    height: 45px !important;\n  }\n\n  section.cyr-menu .cyr-brand-name {\n    font-size: 10px !important;\n    letter-spacing: 0.8px !important;\n  }\n}\n</style>\n\n<section data-bs-version=\"5.1\" class=\"menu menu5 cyr-menu\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n\n<mbr-parameters>\n  <header>Show/Hide</header>\n  <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n  <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"1\" max=\"5\" step=\"0.1\" value=\"4.3\" condition=\"showLogo\">\n  <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\" checked>\n  <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n  <select title=\"Menu Items Align\" name=\"contentAlign\" condition=\"showItems\">\n    <option value=\"1\">Left</option>\n    <option value=\"2\" selected>Center</option>\n    <option value=\"3\">Right</option>\n  </select>\n  <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n  <header>Styles</header>\n  <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\" condition=\"none\">\n  <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n  <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n  <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"1\" condition=\"transparent\">\n  <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#0B120D\">\n  <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#C5ED79\">\n</mbr-parameters>\n\n<nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,'navbar-expand-lg':!collapsed,'collapsed':collapsed}\">\n\n  <div class=\"container\">\n\n    <div class=\"navbar-brand\">\n      <span mbr-if=\"showBrand\" class=\"navbar-caption-wrap\">\n        <a class=\"navbar-caption cyr-logo\" href=\"index.html\">\n\n          <img src=\"@PROJECT_PATH@/assets/images/whatsapp20image202026-11-0320at202.55.4720pm-photoroom-130x130.png\" alt=\"CY Robinson Technologies Logo\" class=\"cyr-logo-image\">\n\n          <span class=\"cyr-brand-name\">\n            CYRILROBINSON.COM\n          </span>\n\n        </a>\n      </span>\n    </div>\n\n    <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarSupportedContent\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showButtons\">\n      <div class=\"hamburger\">\n        <span></span>\n        <span></span>\n        <span></span>\n      </div>\n    </button>\n\n    <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showButtons\">\n\n      <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-if=\"showItems\"><li class=\"nav-item\">\n          <a class=\"nav-link link cyr-link text-primary\" href=\"index.html\" data-app-placeholder=\"Type Text\">Home</a>\n        </li>\n        <li class=\"nav-item\">\n          <a class=\"nav-link link cyr-link text-primary\" href=\"about.html\" data-app-placeholder=\"Type Text\">About</a>\n        </li>\n        <li class=\"nav-item\">\n          <a class=\"nav-link link cyr-link text-primary\" href=\"services.html\" data-app-placeholder=\"Type Text\">Services</a>\n        </li>\n        <li class=\"nav-item\">\n          <a class=\"nav-link link cyr-link text-primary\" href=\"contact.html\" data-app-placeholder=\"Type Text\">Contact</a>\n        </li>\n        <li class=\"nav-item\">\n          <a class=\"nav-link link cyr-link text-primary\" href=\"FAQ.html\" data-app-placeholder=\"Type Text\">FAQ's</a>\n        </li></ul>\n\n      <div mbr-if=\"showButtons\" class=\"navbar-buttons mbr-section-btn\">\n        <a class=\"btn cyr-project-btn\" href=\"contact.html\">\n          Start a Project <span>↗</span>\n        </a>\n      </div>\n\n    </div>\n\n  </div>\n</nav>\n</section>\n```",
