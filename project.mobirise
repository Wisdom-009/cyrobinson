          "_name": "header09",
          "_sourceTheme": "startm5",
          "_customHTML": "```html\n<style>\n.cyr-about {\n  --bg: #0B120D;\n  --surface: #111A13;\n  --surface2: #1A281D;\n  --text: #F4F6F0;\n  --muted: #B5C0B0;\n  --accent: #B7E65C;\n  --line: rgba(197,237,121,.12);\n  background: var(--bg);\n  color: var(--text);\n  font-family: 'Inter', 'Segoe UI', sans-serif;\n  overflow: hidden;\n}\n.cyr-about * { box-sizing: border-box; }\n.cyr-about img { display:block; width:100%; height:100%; object-fit:cover; }\n.cyr-about a { text-decoration:none; }\n.cyr-about .cyr-container { width: min(1160px, 90%); margin:auto; }\n\n/* ANNOUNCEMENT */\n.cyr-about .cyr-announcement {\n  margin-top:90px;\n  padding:15px 20px;\n  background:\n    linear-gradient(100deg,rgba(183,230,92,.12),rgba(90,145,65,.10)),\n    #0B120D;\n  border-top:1px solid rgba(183,230,92,.20);\n  border-bottom:1px solid rgba(183,230,92,.20);\n}\n.cyr-about .cyr-announcement-inner {\n  width:min(1160px,90%);\n  margin:auto;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  gap:18px;\n  flex-wrap:wrap;\n}\n.cyr-about .cyr-announcement-label {\n  color:#B7E65C;\n  font-size:10px;\n  font-weight:800;\n  letter-spacing:2px;\n}\n.cyr-about .cyr-announcement-divider {\n  width:1px;\n  height:19px;\n  background:rgba(255,255,255,.25);\n}\n.cyr-about .cyr-announcement-link {\n  display:inline-flex;\n  align-items:center;\n  gap:12px;\n  color:#F4F6F0 !important;\n  font-size:13px;\n  font-weight:750;\n  letter-spacing:1.1px;\n  transition:.25s ease;\n}\n.cyr-about .cyr-announcement-link span {\n  color:#B7E65C;\n  font-size:19px;\n  transition:transform .25s ease;\n}\n.cyr-about .cyr-announcement-link:hover {\n  color:#D0EF78 !important;\n}\n.cyr-about .cyr-announcement-link:hover span {\n  transform:translate(3px,-3px);\n}\n\n/* DEFAULT TEXT COLOURS */\n.cyr-about h1,.cyr-about h2,.cyr-about h3 {\n  color:var(--text);\n  line-height:1.15;\n}\n.cyr-about p {\n  color:var(--muted);\n  line-height:1.85;\n  font-size:15px;\n}\n.cyr-about .cyr-eyebrow {\n  color:#B7E65C;\n  font-size:12px;\n  font-weight:700;\n  letter-spacing:2.5px;\n  text-transform:uppercase;\n  margin-bottom:18px;\n}\n\n/* HERO */\n.cyr-about .cyr-hero {\n  padding:100px 0 90px;\n  background:\n    radial-gradient(ellipse at 80% 15%,rgba(183,230,92,.16),transparent 42%),\n    radial-gradient(ellipse at 5% 85%,rgba(90,145,65,.12),transparent 38%),\n    #0B120D;\n}\n.cyr-about .cyr-hero-grid {\n  display:grid;\n  grid-template-columns:1.05fr .95fr;\n  gap:65px;\n  align-items:center;\n}\n.cyr-about .cyr-hero h1 {\n  font-size:clamp(42px,6vw,70px);\n  letter-spacing:-2.8px;\n  font-weight:750;\n  margin:0 0 24px;\n  color:#F4F6F0;\n}\n.cyr-about .cyr-hero h1 span {\n  background:linear-gradient(100deg,#C5ED79,#8FC65A,#D8F29B);\n  -webkit-background-clip:text;\n  background-clip:text;\n  color:transparent;\n}\n.cyr-about .cyr-hero-copy {\n  max-width:540px;\n  font-size:17px;\n  color:#B5C0B0;\n}\n.cyr-about .cyr-hero-image {\n  height:470px;\n  border-radius:22px;\n  overflow:hidden;\n  border:1px solid var(--line);\n  position:relative;\n}\n.cyr-about .cyr-hero-image:after {\n  content:\"\";\n  position:absolute;\n  inset:0;\n  background:linear-gradient(0deg,rgba(5,12,6,.28),transparent 55%);\n  pointer-events:none;\n}\n.cyr-about .cyr-button {\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n  padding:15px 25px;\n  border-radius:7px;\n  margin-top:24px;\n  color:#14200F !important;\n  font-weight:700;\n  font-size:14px;\n  background:linear-gradient(110deg,#A6D84D,#D0EF78);\n  transition:.25s ease;\n  box-shadow:0 8px 25px rgba(166,216,77,.12);\n}\n.cyr-about .cyr-button:hover {\n  transform:translateY(-3px);\n  color:#14200F !important;\n  box-shadow:0 12px 30px rgba(166,216,77,.22);\n}\n.cyr-about .cyr-text-link {\n  display:inline-block;\n  margin:24px 0 0 20px;\n  color:#D0EF78 !important;\n  font-size:14px;\n  font-weight:600;\n}\n\n/* GENERAL SECTIONS */\n.cyr-about .cyr-section {\n  padding:100px 0;\n  background:#0B120D;\n}\n.cyr-about .cyr-section-heading {\n  max-width:720px;\n  margin-bottom:48px;\n}\n.cyr-about .cyr-section-heading h2 {\n  font-size:clamp(32px,4vw,48px);\n  letter-spacing:-1.5px;\n  font-weight:700;\n  margin:0 0 18px;\n}\n\n/* INTRODUCTION */\n.cyr-about .cyr-intro-grid {\n  display:grid;\n  grid-template-columns:.9fr 1.1fr;\n  gap:65px;\n  align-items:center;\n}\n.cyr-about .cyr-intro-image {\n  height:420px;\n  border-radius:18px;\n  overflow:hidden;\n  border:1px solid var(--line);\n}\n.cyr-about .cyr-intro-copy h2 {\n  font-size:clamp(31px,4vw,45px);\n  letter-spacing:-1.3px;\n  margin:0 0 22px;\n  color:#F4F6F0 !important;\n}\n.cyr-about .cyr-intro-copy p {\n  margin-bottom:17px;\n  color:#B5C0B0 !important;\n}\n.cyr-about .cyr-intro-copy .cyr-eyebrow {\n  color:#B7E65C !important;\n}\n\n/* CORE VALUES */\n.cyr-about .cyr-values {\n  background:#111A13;\n  border-top:1px solid var(--line);\n  border-bottom:1px solid var(--line);\n  padding:32px 0;\n}\n.cyr-about .cyr-values-grid {\n  display:grid;\n  grid-template-columns:repeat(3,1fr);\n  gap:25px;\n}\n.cyr-about .cyr-value {\n  text-align:center;\n  padding:12px;\n}\n.cyr-about .cyr-value strong {\n  display:block;\n  color:#F4F6F0 !important;\n  font-size:15px;\n  margin-bottom:7px;\n}\n.cyr-about .cyr-value span {\n  color:#B5C0B0 !important;\n  font-size:13px;\n}\n\n/* MISSION AND VISION */\n.cyr-about .cyr-mv {\n  background:#0D160F;\n}\n.cyr-about .cyr-mv h2,\n.cyr-about .cyr-mv h3 {\n  color:#F4F6F0 !important;\n}\n.cyr-about .cyr-mv p {\n  color:#B5C0B0 !important;\n}\n.cyr-about .cyr-mv .cyr-eyebrow {\n  color:#B7E65C !important;\n}\n.cyr-about .cyr-mv-grid {\n  display:grid;\n  grid-template-columns:1fr 1fr;\n  gap:25px;\n}\n.cyr-about .cyr-mv-card {\n  background:#111A13;\n  border:1px solid var(--line);\n  border-radius:17px;\n  overflow:hidden;\n  transition:.25s ease;\n}\n.cyr-about .cyr-mv-card:hover {\n  border-color:rgba(183,230,92,.30);\n  transform:translateY(-3px);\n}\n.cyr-about .cyr-mv-card img { height:245px; }\n.cyr-about .cyr-mv-content { padding:30px; }\n.cyr-about .cyr-mv-content h3 {\n  font-size:25px;\n  margin:0 0 14px;\n}\n\n/* APPROACH */\n.cyr-about .cyr-approach-grid {\n  display:grid;\n  grid-template-columns:1fr 1fr;\n  gap:65px;\n  align-items:center;\n}\n.cyr-about .cyr-approach-image {\n  height:460px;\n  border-radius:18px;\n  overflow:hidden;\n  border:1px solid var(--line);\n}\n.cyr-about .cyr-approach-copy h2 {\n  font-size:clamp(32px,4vw,46px);\n  letter-spacing:-1.5px;\n  margin:0 0 20px;\n  color:#F4F6F0 !important;\n}\n.cyr-about .cyr-approach-copy > p {\n  color:#B5C0B0 !important;\n}\n.cyr-about .cyr-approach-copy .cyr-eyebrow {\n  color:#B7E65C !important;\n}\n.cyr-about .cyr-step {\n  display:flex;\n  gap:18px;\n  padding:19px 0;\n  border-bottom:1px solid rgba(197,237,121,.13);\n}\n.cyr-about .cyr-step-number {\n  flex:0 0 37px;\n  height:37px;\n  display:grid;\n  place-items:center;\n  border-radius:50%;\n  color:#C5ED79 !important;\n  background:rgba(183,230,92,.13);\n  font-size:13px;\n  font-weight:700;\n}\n.cyr-about .cyr-step h3 {\n  font-size:17px;\n  margin:2px 0 7px;\n  color:#F4F6F0 !important;\n}\n.cyr-about .cyr-step p {\n  font-size:13px;\n  margin:0;\n  color:#B5C0B0 !important;\n}\n\n/* EXPERTISE */\n.cyr-about .cyr-expertise {\n  background:#0D160F;\n}\n.cyr-about .cyr-expertise h2,\n.cyr-about .cyr-expertise h3 {\n  color:#F4F6F0 !important;\n}\n.cyr-about .cyr-expertise p {\n  color:#B5C0B0 !important;\n}\n.cyr-about .cyr-expertise .cyr-eyebrow {\n  color:#B7E65C !important;\n}\n.cyr-about .cyr-service-grid {\n  display:grid;\n  grid-template-columns:repeat(2,1fr);\n  gap:24px;\n}\n.cyr-about .cyr-service-card {\n  background:#111A13;\n  border:1px solid var(--line);\n  border-radius:16px;\n  overflow:hidden;\n  transition:.25s ease;\n}\n.cyr-about .cyr-service-card:hover {\n  transform:translateY(-5px);\n  border-color:rgba(183,230,92,.35);\n}\n.cyr-about .cyr-service-card img { height:260px; }\n.cyr-about .cyr-service-content { padding:27px; }\n.cyr-about .cyr-service-content h3 {\n  font-size:22px;\n  margin:0 0 12px;\n}\n.cyr-about .cyr-service-content p {\n  margin:0;\n  font-size:14px;\n}\n\n/* OUR COMMITMENT */\n.cyr-about .cyr-commitment-grid {\n  display:grid;\n  grid-template-columns:1fr 1fr;\n  gap:55px;\n  align-items:center;\n}\n.cyr-about .cyr-commitment-image {\n  height:390px;\n  border-radius:18px;\n  overflow:hidden;\n  border:1px solid var(--line);\n}\n.cyr-about .cyr-commitment-copy h2 {\n  font-size:clamp(30px,4vw,43px);\n  margin:0 0 18px;\n  letter-spacing:-1.3px;\n  color:#F4F6F0 !important;\n}\n.cyr-about .cyr-commitment-copy > p {\n  color:#B5C0B0 !important;\n}\n.cyr-about .cyr-commitment-copy .cyr-eyebrow {\n  color:#B7E65C !important;\n}\n.cyr-about .cyr-commitment-points { margin-top:24px; }\n.cyr-about .cyr-commitment-points div {\n  padding:13px 0;\n  border-bottom:1px solid rgba(197,237,121,.13);\n  color:#E3EBDD !important;\n  font-size:14px;\n  line-height:1.6;\n}\n.cyr-about .cyr-commitment-points span {\n  color:#B7E65C !important;\n  margin-right:12px;\n}\n\n/* CONTACT CTA */\n.cyr-about .cyr-cta {\n  padding:90px 0;\n  text-align:center;\n  background:\n    linear-gradient(90deg,rgba(7,15,8,.94),rgba(7,15,8,.82)),\n    url('https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1800&q=85') center/cover;\n}\n.cyr-about .cyr-cta-inner {\n  max-width:760px;\n  margin:auto;\n}\n.cyr-about .cyr-cta h2 {\n  font-size:clamp(34px,5vw,54px);\n  letter-spacing:-1.7px;\n  margin:0 0 18px;\n  color:#F4F6F0 !important;\n}\n.cyr-about .cyr-cta p {\n  max-width:600px;\n  margin:auto;\n  color:#C5CEC0 !important;\n}\n.cyr-about .cyr-cta .cyr-eyebrow {\n  color:#C5ED79 !important;\n}\n\n/* FOOTER */\n.cyr-about .cyr-footer {\n  background:#080E09;\n  padding:28px 0;\n  border-top:1px solid var(--line);\n}\n.cyr-about .cyr-footer-inner {\n  display:flex;\n  justify-content:space-between;\n  align-items:center;\n  gap:20px;\n  flex-wrap:wrap;\n}\n.cyr-about .cyr-footer strong {\n  color:#F4F6F0 !important;\n  letter-spacing:1px;\n}\n.cyr-about .cyr-footer p {\n  font-size:12px;\n  margin:0;\n  color:#A5B09F !important;\n}\n\n/* RESPONSIVE */\n@media(max-width:850px) {\n  .cyr-about .cyr-hero-grid,\n  .cyr-about .cyr-intro-grid,\n  .cyr-about .cyr-approach-grid,\n  .cyr-about .cyr-commitment-grid {\n    grid-template-columns:1fr;\n    gap:35px;\n  }\n  .cyr-about .cyr-hero { padding:75px 0 65px; }\n  .cyr-about .cyr-hero-image { height:360px; }\n  .cyr-about .cyr-intro-image,\n  .cyr-about .cyr-approach-image { height:340px; }\n}\n@media(max-width:600px) {\n  .cyr-about .cyr-announcement {\n    margin-top:75px;\n    padding:13px 12px;\n  }\n  .cyr-about .cyr-announcement-inner {\n    gap:9px;\n  }\n  .cyr-about .cyr-announcement-label {\n    font-size:9px;\n  }\n  .cyr-about .cyr-announcement-divider {\n    height:15px;\n  }\n  .cyr-about .cyr-announcement-link {\n    font-size:11px;\n    letter-spacing:.5px;\n    gap:7px;\n  }\n  .cyr-about .cyr-section { padding:70px 0; }\n  .cyr-about .cyr-mv-grid,\n  .cyr-about .cyr-service-grid {\n    grid-template-columns:1fr;\n  }\n  .cyr-about .cyr-values-grid {\n    grid-template-columns:1fr;\n    gap:10px;\n  }\n  .cyr-about .cyr-hero h1 { letter-spacing:-1.7px; }\n  .cyr-about .cyr-hero-image { height:280px; }\n  .cyr-about .cyr-mv-card img,\n  .cyr-about .cyr-service-card img { height:220px; }\n  .cyr-about .cyr-text-link {\n    margin-left:0;\n    display:block;\n  }\n  .cyr-about .cyr-footer-inner {\n    flex-direction:column;\n    align-items:flex-start;\n  }\n}\n</style>\n\n<section data-bs-version=\"5.1\" class=\"cyr-about\" id=\"cyr-about\">\n\n  <!-- ANNOUNCEMENT -->\n  <section class=\"cyr-announcement\">\n    <div class=\"cyr-announcement-inner\">\n      <span class=\"cyr-announcement-label\">SPECIAL ANNOUNCEMENT</span>\n      <span class=\"cyr-announcement-divider\"></span>\n      <a href=\"digital-radio.html\" class=\"cyr-announcement-link\">\n        DIGITAL RADIO AT AFFORDABLE PRICE\n        <span>↗</span>\n      </a>\n    </div>\n  </section>\n\n  <!-- ABOUT HERO -->\n  <section class=\"cyr-hero\">\n    <div class=\"cyr-container cyr-hero-grid\">\n      <div>\n        <div class=\"cyr-eyebrow\">ABOUT CY ROBINSON TECHNOLOGIES</div>\n        <h1>Building digital solutions <span>with purpose.</span></h1>\n        <p class=\"cyr-hero-copy\">\n          We create and manage digital solutions that help businesses\n          establish a stronger online presence, improve how they work,\n          and make better use of their information.\n        </p>\n        <a href=\"about.html\" class=\"cyr-button\">Explore Our Expertise</a>\n        <a href=\"about.html\" class=\"cyr-text-link\">Let's talk about your project</a>\n      </div>\n      <div class=\"cyr-hero-image\">\n        <img src=\"https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=1200&q=85\" alt=\"Modern computer workspace with website development on screen\">\n      </div>\n    </div>\n  </section>\n\n  <!-- INTRODUCTION -->\n  <section class=\"cyr-section\">\n    <div class=\"cyr-container cyr-intro-grid\">\n      <div class=\"cyr-intro-image\">\n        <img src=\"https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&fit=crop&w=1100&q=85\" alt=\"Modern professional workspace\">\n      </div>\n      <div class=\"cyr-intro-copy\">\n        <div class=\"cyr-eyebrow\">WHO WE ARE</div>\n        <h2>Technology should solve problems, not create them.</h2>\n        <p>\n          CY Robinson Technologies focuses on building practical digital\n          solutions around the needs of businesses and individuals.\n          We believe technology is most valuable when it is purposeful,\n          accessible, and designed to make everyday work easier.\n        </p>\n        <p>\n          Our work centres on website design, web development, database\n          creation, and database management. These areas allow us to help\n          turn ideas into functional digital experiences and organised\n          information systems.\n        </p>\n        <p>\n          Whether the goal is to establish an online presence or improve\n          the way information is stored and managed, we approach each\n          project with attention to its purpose and intended users.\n        </p>\n      </div>\n    </div>\n  </section>\n\n  <!-- CORE VALUES STRIP -->\n  <section class=\"cyr-values\">\n    <div class=\"cyr-container cyr-values-grid\">\n      <div class=\"cyr-value\">\n        <strong>Purposeful Solutions</strong>\n        <span>Technology built around real needs.</span>\n      </div>\n      <div class=\"cyr-value\">\n        <strong>Attention to Detail</strong>\n        <span>Care in both design and functionality.</span>\n      </div>\n      <div class=\"cyr-value\">\n        <strong>Practical Thinking</strong>\n        <span>Clear solutions with a useful purpose.</span>\n      </div>\n    </div>\n  </section>\n\n  <!-- MISSION AND VISION -->\n  <section class=\"cyr-section cyr-mv\">\n    <div class=\"cyr-container\">\n      <div class=\"cyr-section-heading\">\n        <div class=\"cyr-eyebrow\">OUR DIRECTION</div>\n        <h2>What guides our work.</h2>\n        <p>\n          Every digital project should have a clear reason for existing.\n          Our mission and vision provide direction for the solutions\n          we aim to create.\n        </p>\n      </div>\n\n      <div class=\"cyr-mv-grid\">\n        <article class=\"cyr-mv-card\">\n          <img src=\"https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=1100&q=85\" alt=\"People working together around a table\">\n          <div class=\"cyr-mv-content\">\n            <h3>Our Mission</h3>\n            <p>\n              To create useful, reliable, and thoughtfully developed\n              digital solutions that help businesses and individuals\n              communicate, operate, and manage information more effectively.\n            </p>\n          </div>\n        </article>\n\n        <article class=\"cyr-mv-card\">\n          <img src=\"https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=1100&q=85\" alt=\"Digital network and connected technology\">\n          <div class=\"cyr-mv-content\">\n            <h3>Our Vision</h3>\n            <p>\n              To build a trusted technology brand recognised for practical\n              digital solutions, thoughtful development, and a commitment\n              to helping people and businesses make better use of technology.\n            </p>\n          </div>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <!-- OUR APPROACH -->\n  <section class=\"cyr-section\">\n    <div class=\"cyr-container cyr-approach-grid\">\n      <div class=\"cyr-approach-copy\">\n        <div class=\"cyr-eyebrow\">HOW WE WORK</div>\n        <h2>A clear process. A purposeful result.</h2>\n        <p>\n          Good digital work begins with understanding what needs to be\n          achieved. We place importance on the purpose of a project before\n          moving into its design, development, or implementation.\n        </p>\n\n        <div class=\"cyr-step\">\n          <div class=\"cyr-step-number\">01</div>\n          <div>\n            <h3>Understand</h3>\n            <p>Identify the project goals, requirements, and intended users.</p>\n          </div>\n        </div>\n        <div class=\"cyr-step\">\n          <div class=\"cyr-step-number\">02</div>\n          <div>\n            <h3>Plan</h3>\n            <p>Determine the structure, features, and appropriate direction.</p>\n          </div>\n        </div>\n        <div class=\"cyr-step\">\n          <div class=\"cyr-step-number\">03</div>\n          <div>\n            <h3>Develop</h3>\n            <p>Turn the plan into a functional and carefully considered solution.</p>\n          </div>\n        </div>\n        <div class=\"cyr-step\">\n          <div class=\"cyr-step-number\">04</div>\n          <div>\n            <h3>Review and Deliver</h3>\n            <p>Check the result against the project requirements before delivery.</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"cyr-approach-image\">\n        <img src=\"https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=1100&q=85\" alt=\"Website analytics and digital project planning\">\n      </div>\n    </div>\n  </section>\n\n  <!-- OUR EXPERTISE -->\n  <section class=\"cyr-section cyr-expertise\" id=\"cyr-about-services\">\n    <div class=\"cyr-container\">\n      <div class=\"cyr-section-heading\">\n        <div class=\"cyr-eyebrow\">WHAT WE DO</div>\n        <h2>Our areas of expertise.</h2>\n        <p>\n          Our services focus on four connected areas of digital technology.\n          Each addresses a different part of building and maintaining\n          effective digital solutions.\n        </p>\n      </div>\n\n      <div class=\"cyr-service-grid\">\n        <article class=\"cyr-service-card\">\n          <img src=\"https://images.unsplash.com/photo-1547658719-da2b51169166?auto=format&fit=crop&w=1100&q=85\" alt=\"Website layout and visual design\">\n          <div class=\"cyr-service-content\">\n            <h3>Website Design</h3>\n            <p>\n              We design clear, attractive, and user-focused websites that\n              communicate a brand's message and help visitors understand\n              what a business offers. Our focus is on structure, visual\n              consistency, usability, and responsive presentation.\n            </p>\n          </div>\n        </article>\n\n        <article class=\"cyr-service-card\">\n          <img src=\"https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=1100&q=85\" alt=\"Code displayed on a computer screen\">\n          <div class=\"cyr-service-content\">\n            <h3>Web Development</h3>\n            <p>\n              We develop websites by bringing design and functionality\n              together. This includes implementing website features,\n              structuring pages, improving usability, and making sure\n              the finished website works across different screen sizes.\n            </p>\n          </div>\n        </article>\n\n        <article class=\"cyr-service-card\">\n          <img src=\"https://images.unsplash.com/photo-1544383835-bda2bc66a55d?auto=format&fit=crop&w=1100&q=85\" alt=\"Database information represented on a computer\">\n          <div class=\"cyr-service-content\">\n            <h3>Database Creation</h3>\n            <p>\n              We create structured databases designed to organise\n              information in a logical and useful way. A well-planned\n              database provides a foundation for storing, retrieving,\n              and working with important business information.\n            </p>\n          </div>\n        </article>\n\n        <article class=\"cyr-service-card\">\n          <img src=\"https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1100&q=85\" alt=\"Data analytics and information management dashboard\">\n          <div class=\"cyr-service-content\">\n            <h3>Database Management</h3>\n            <p>\n              We focus on organising, maintaining, and managing stored\n              information. Effective database management helps keep\n              records structured, supports reliable access to data,\n              and makes information easier to work with.\n            </p>\n          </div>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <!-- OUR COMMITMENT -->\n  <section class=\"cyr-section\">\n    <div class=\"cyr-container cyr-commitment-grid\">\n      <div class=\"cyr-commitment-image\">\n        <img src=\"https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=1100&q=85\" alt=\"Digital work and technology collaboration\">\n      </div>\n      <div class=\"cyr-commitment-copy\">\n        <div class=\"cyr-eyebrow\">OUR COMMITMENT</div>\n        <h2>Built around what matters.</h2>\n        <p>\n          A good solution is not simply about adding more features or\n          making something look impressive. It is about making sure the\n          result serves its purpose and works for the people who use it.\n        </p>\n        <p>\n          That is why we value clear requirements, thoughtful design,\n          functional development, and organised information. These\n          principles shape the way we approach our work.\n        </p>\n        <div class=\"cyr-commitment-points\">\n          <div><span>✦</span> Solutions guided by clear objectives</div>\n          <div><span>✦</span> Design with usability in mind</div>\n          <div><span>✦</span> Functionality that supports the purpose</div>\n          <div><span>✦</span> Attention to structure and detail</div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- CONTACT CTA -->\n  <section class=\"cyr-cta\" id=\"cyr-about-contact\">\n    <div class=\"cyr-container cyr-cta-inner\">\n      <div class=\"cyr-eyebrow\">LET'S BUILD SOMETHING USEFUL</div>\n      <h2>Have a digital project in mind?</h2>\n      <p>\n        Whether you need a website, a web development solution,\n        or a better way to organise your information, let's discuss\n        what you want to achieve.\n      </p>\n      <a href=\"contact.html\" class=\"cyr-button\">Start a Conversation</a>\n    </div>\n  </section>\n\n  <!-- FOOTER -->\n  <footer class=\"cyr-footer\">\n    <div class=\"cyr-container cyr-footer-inner\">\n      <strong>CY ROBINSON TECHNOLOGIES</strong>\n      <p>Website Design · Web Development · Database Solutions</p>\n      <p>© CY Robinson Technologies. All rights reserved.</p>\n    </div>\n  </footer>\n\n</section>\n```",
          "_isUserblock": true,
          "_cid": "vzV3ufh81D",
          "_anchor": "header09-5",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        }
      ]
    },
    "services.html": {
      "settings": {
        "title": "Services",
        "meta_descr": "",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "order": "3"
      },
      "components": [
        {
          "alias": false,
          "_styles": {},
          "_name": "menu05",
          "_sourceTheme": "startm5",
          "_customHTML": "```html\n<style>\n/* =====================================\n   CY ROBINSON TECHNOLOGIES\n   FULL-WIDTH GREEN NAVIGATION\n===================================== */\n\nsection.cyr-menu {\n  position: relative !important;\n  z-index: 9999 !important;\n  width: 100% !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  background: #0B120D !important;\n}\n\nsection.cyr-menu nav.navbar {\n  width: 100% !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  background: transparent !important;\n  box-shadow: none !important;\n}\n\nsection.cyr-menu nav.navbar > .container {\n  width: 100% !important;\n  max-width: 100% !important;\n  min-height: 100px !important;\n  margin: 0 auto !important;\n  padding: 15px 6% !important;\n  display: flex !important;\n  align-items: center !important;\n  justify-content: space-between !important;\n  flex-wrap: nowrap !important;\n  background: linear-gradient(105deg,#0B120D 0%,#111A13 55%,#162218 100%) !important;\n  border: 0 !important;\n  border-bottom: 1px solid rgba(197,237,121,0.16) !important;\n  border-radius: 0 !important;\n  box-shadow: 0 8px 28px rgba(0,0,0,0.20) !important;\n  box-sizing: border-box !important;\n}\n\n/* LOGO AND BRAND NAME */\n\nsection.cyr-menu .navbar-brand {\n  margin: 0 !important;\n  padding: 0 !important;\n  display: flex !important;\n  align-items: center !important;\n  flex-shrink: 0 !important;\n}\n\nsection.cyr-menu .navbar-caption-wrap {\n  padding: 0 !important;\n}\n\nsection.cyr-menu a.cyr-logo {\n  display: inline-flex !important;\n  align-items: center !important;\n  gap: 14px !important;\n  padding: 0 !important;\n  margin: 0 !important;\n  text-decoration: none !important;\n  background: transparent !important;\n  line-height: 1 !important;\n}\n\nsection.cyr-menu .cyr-logo-image {\n  display: block !important;\n  width: 65px !important;\n  height: 65px !important;\n  object-fit: contain !important;\n  object-position: center !important;\n  flex-shrink: 0 !important;\n}\n\nsection.cyr-menu .cyr-brand-name {\n  display: block !important;\n  color: #ffffff !important;\n  font-family: Arial, sans-serif !important;\n  font-size: 15px !important;\n  font-weight: 800 !important;\n  letter-spacing: 1.8px !important;\n  line-height: 1.4 !important;\n  white-space: nowrap !important;\n}\n\n/* NAVIGATION LINKS */\n\nsection.cyr-menu .navbar-collapse {\n  align-items: center !important;\n  justify-content: flex-end !important;\n}\n\nsection.cyr-menu ul.navbar-nav {\n  display: flex !important;\n  align-items: center !important;\n  gap: 12px !important;\n  margin: 0 32px 0 auto !important;\n  padding: 0 !important;\n}\n\nsection.cyr-menu ul.navbar-nav li {\n  margin: 0 !important;\n  padding: 0 !important;\n}\n\nsection.cyr-menu a.cyr-link {\n  display: inline-block !important;\n  padding: 13px 16px !important;\n  border-radius: 8px !important;\n  color: #B5C0B0 !important;\n  font-family: Arial,sans-serif !important;\n  font-size: 13px !important;\n  font-weight: 500 !important;\n  text-decoration: none !important;\n  background: transparent !important;\n  transition: all .25s ease !important;\n}\n\nsection.cyr-menu a.cyr-link:hover {\n  color: #D0EF78 !important;\n  background: rgba(183,230,92,0.10) !important;\n}\n\n/* PROJECT BUTTON */\n\nsection.cyr-menu .navbar-buttons {\n  margin: 0 !important;\n  padding: 0 !important;\n}\n\nsection.cyr-menu a.cyr-project-btn {\n  min-height: 49px !important;\n  padding: 0 24px !important;\n  display: inline-flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  gap: 13px !important;\n  border: 1px solid rgba(197,237,121,0.25) !important;\n  border-radius: 9px !important;\n  background: linear-gradient(110deg,#A6D84D,#D0EF78) !important;\n  color: #14200F !important;\n  font-family: Arial,sans-serif !important;\n  font-size: 12px !important;\n  font-weight: 800 !important;\n  text-decoration: none !important;\n  box-shadow: 0 7px 22px rgba(143,191,77,0.17) !important;\n  transition: all .25s ease !important;\n}\n\nsection.cyr-menu a.cyr-project-btn span {\n  color: #14200F !important;\n  font-size: 18px !important;\n}\n\nsection.cyr-menu a.cyr-project-btn:hover {\n  color: #14200F !important;\n  transform: translateY(-2px) !important;\n  box-shadow: 0 10px 28px rgba(183,230,92,0.27) !important;\n}\n\n/* MOBILE MENU BUTTON */\n\nsection.cyr-menu button.navbar-toggler {\n  display: none;\n  padding: 11px !important;\n  border: 1px solid rgba(197,237,121,0.22) !important;\n  border-radius: 9px !important;\n  background: rgba(183,230,92,0.07) !important;\n  box-shadow: none !important;\n}\n\nsection.cyr-menu .hamburger {\n  width: 23px !important;\n  height: 18px !important;\n  display: flex !important;\n  flex-direction: column !important;\n  justify-content: space-between !important;\n}\n\nsection.cyr-menu .hamburger span {\n  display: block !important;\n  width: 100% !important;\n  height: 2px !important;\n  border-radius: 5px !important;\n  background: #C5ED79 !important;\n}\n\n/* TABLET AND MOBILE */\n\n@media (max-width: 991px) {\n  section.cyr-menu nav.navbar > .container {\n    min-height: 82px !important;\n    padding: 12px 5% !important;\n    flex-wrap: wrap !important;\n  }\n\n  section.cyr-menu .cyr-logo-image {\n    width: 55px !important;\n    height: 55px !important;\n  }\n\n  section.cyr-menu .cyr-brand-name {\n    font-size: 13px !important;\n    letter-spacing: 1.2px !important;\n  }\n\n  section.cyr-menu button.navbar-toggler {\n    display: flex !important;\n    margin-left: auto !important;\n  }\n\n  section.cyr-menu .navbar-collapse {\n    width: 100% !important;\n    flex-basis: 100% !important;\n    margin-top: 13px !important;\n    padding: 14px 5px 5px !important;\n    border-top: 1px solid rgba(197,237,121,0.13) !important;\n  }\n\n  section.cyr-menu ul.navbar-nav {\n    width: 100% !important;\n    margin: 0 !important;\n    display: flex !important;\n    flex-direction: column !important;\n    align-items: stretch !important;\n    gap: 3px !important;\n  }\n\n  section.cyr-menu a.cyr-link {\n    display: block !important;\n    width: 100% !important;\n    padding: 13px 12px !important;\n  }\n\n  section.cyr-menu .navbar-buttons {\n    width: 100% !important;\n    margin-top: 12px !important;\n  }\n\n  section.cyr-menu a.cyr-project-btn {\n    width: 100% !important;\n  }\n}\n\n@media (max-width: 480px) {\n  section.cyr-menu nav.navbar > .container {\n    min-height: 74px !important;\n    padding: 9px 4% !important;\n  }\n\n  section.cyr-menu a.cyr-logo {\n    gap: 9px !important;\n  }\n\n  section.cyr-menu .cyr-logo-image {\n    width: 45px !important;\n    height: 45px !important;\n  }\n\n  section.cyr-menu .cyr-brand-name {\n    font-size: 10px !important;\n    letter-spacing: 0.8px !important;\n  }\n}\n</style>\n\n<section data-bs-version=\"5.1\" class=\"menu menu5 cyr-menu\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n\n<mbr-parameters>\n  <header>Show/Hide</header>\n  <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n  <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"1\" max=\"5\" step=\"0.1\" value=\"4.3\" condition=\"showLogo\">\n  <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\" checked>\n  <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n  <select title=\"Menu Items Align\" name=\"contentAlign\" condition=\"showItems\">\n    <option value=\"1\">Left</option>\n    <option value=\"2\" selected>Center</option>\n    <option value=\"3\">Right</option>\n  </select>\n  <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n  <header>Styles</header>\n  <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\" condition=\"none\">\n  <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n  <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n  <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"1\" condition=\"transparent\">\n  <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#0B120D\">\n  <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#C5ED79\">\n</mbr-parameters>\n\n<nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,'navbar-expand-lg':!collapsed,'collapsed':collapsed}\">\n\n  <div class=\"container\">\n\n    <div class=\"navbar-brand\">\n      <span mbr-if=\"showBrand\" class=\"navbar-caption-wrap\">\n        <a class=\"navbar-caption cyr-logo\" href=\"index.html\">\n\n          <img src=\"@PROJECT_PATH@/assets/images/whatsapp20image202026-11-0320at202.55.4720pm-photoroom-130x130.png\" alt=\"CY Robinson Technologies Logo\" class=\"cyr-logo-image\">\n\n          <span class=\"cyr-brand-name\">\n            CYRILROBINSON.COM\n          </span>\n\n        </a>\n      </span>\n    </div>\n\n    <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarSupportedContent\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showButtons\">\n      <div class=\"hamburger\">\n        <span></span>\n        <span></span>\n        <span></span>\n      </div>\n    </button>\n\n    <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showButtons\">\n\n      <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-if=\"showItems\"><li class=\"nav-item\">\n          <a class=\"nav-link link cyr-link text-primary\" href=\"index.html\" data-app-placeholder=\"Type Text\">Home</a>\n        </li>\n        <li class=\"nav-item\">\n          <a class=\"nav-link link cyr-link text-primary\" href=\"about.html\" data-app-placeholder=\"Type Text\">About</a>\n        </li>\n        <li class=\"nav-item\">\n          <a class=\"nav-link link cyr-link text-primary\" href=\"services.html\" data-app-placeholder=\"Type Text\">Services</a>\n        </li>\n        <li class=\"nav-item\">\n          <a class=\"nav-link link cyr-link text-primary\" href=\"contact.html\" data-app-placeholder=\"Type Text\">Contact</a>\n        </li>\n        <li class=\"nav-item\">\n          <a class=\"nav-link link cyr-link text-primary\" href=\"FAQ.html\" data-app-placeholder=\"Type Text\">FAQ's</a>\n        </li></ul>\n\n      <div mbr-if=\"showButtons\" class=\"navbar-buttons mbr-section-btn\">\n        <a class=\"btn cyr-project-btn\" href=\"contact.html\">\n          Start a Project <span>↗</span>\n        </a>\n      </div>\n\n    </div>\n\n  </div>\n</nav>\n</section>\n```",
