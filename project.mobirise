        },
        {
          "alias": false,
          "_styles": {},
          "_name": "header09",
          "_sourceTheme": "startm5",
          "_customHTML": "```html\n<style>\n/* =========================================\n   CY ROBINSON TECHNOLOGIES\n   GREEN THEME HOMEPAGE + ANNOUNCEMENT\n========================================= */\n\n.cyr-site {\n    background: #0B120D !important;\n    color: #F4F5FA;\n    font-family: Arial, Helvetica, sans-serif;\n    overflow: hidden;\n}\n\n.cyr-site * {\n    box-sizing: border-box;\n}\n\n.cyr-site a {\n    text-decoration: none;\n}\n\n.cyr-wrap {\n    width: 90%;\n    max-width: 1220px;\n    margin: auto;\n}\n\n.cyr-eyebrow {\n    color: #B7E65C;\n    font-size: 11px;\n    letter-spacing: 3px;\n    font-weight: 700;\n    text-transform: uppercase;\n}\n\n.cyr-gradient-text {\n    background: linear-gradient(100deg, #C5ED79, #8FC65A, #D8F29B);\n    -webkit-background-clip: text;\n    background-clip: text;\n    color: transparent;\n}\n\n/* ANNOUNCEMENT */\n\n.cyr-announcement {\n    width: 100%;\n    position: relative;\n    overflow: hidden;\n    background:\n        radial-gradient(ellipse at 15% 50%, rgba(91,135,57,.18), transparent 45%),\n        linear-gradient(100deg, #111C14, #19251A, #111C14) !important;\n    border-top: 1px solid rgba(183,230,92,.12);\n    border-bottom: 1px solid rgba(183,230,92,.12);\n    font-family: Arial, Helvetica, sans-serif;\n    margin-top: 90px;\n    z-index: 1;\n}\n\n.cyr-announcement-inner {\n    width: 90%;\n    max-width: 1220px;\n    min-height: 58px;\n    margin: auto;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 16px;\n    padding: 12px 0;\n    text-align: center;\n}\n\n.cyr-announcement-label {\n    color: #C5ED79;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n    white-space: nowrap;\n}\n\n.cyr-announcement-divider {\n    width: 1px;\n    height: 19px;\n    background: rgba(255,255,255,.25);\n}\n\n.cyr-announcement-link {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    color: #FFFFFF !important;\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 1.1px;\n    text-decoration: none !important;\n    transition: color .25s ease;\n}\n\n.cyr-announcement-link span {\n    color: #C5ED79;\n    font-size: 17px;\n    transition: transform .25s ease;\n}\n\n.cyr-announcement-link:hover {\n    color: #D8F29B !important;\n}\n\n.cyr-announcement-link:hover span {\n    transform: translate(3px,-3px);\n}\n\n/* HERO */\n\n.cyr-hero {\n    position: relative;\n    padding: 105px 0 65px;\n    background:\n        radial-gradient(ellipse at 78% 25%, rgba(91,135,57,.24), transparent 38%),\n        radial-gradient(ellipse at 5% 85%, rgba(91,135,57,.13), transparent 35%),\n        #0B120D !important;\n}\n\n.cyr-hero:before {\n    content: \"\";\n    position: absolute;\n    width: 450px;\n    height: 450px;\n    border: 1px solid rgba(183,230,92,.09);\n    border-radius: 50%;\n    right: -170px;\n    top: 30px;\n    pointer-events: none;\n}\n\n.cyr-hero-layout {\n    display: flex;\n    align-items: center;\n    gap: 55px;\n    position: relative;\n    z-index: 1;\n}\n\n.cyr-hero-copy {\n    width: 53%;\n}\n\n.cyr-hero-copy h1 {\n    color: #FFFFFF;\n    font-size: 66px;\n    line-height: 1.04;\n    letter-spacing: -3.5px;\n    margin: 22px 0;\n    font-weight: 750;\n}\n\n.cyr-hero-copy p {\n    color: #B5C0B0;\n    max-width: 490px;\n    line-height: 1.9;\n    font-size: 16px;\n}\n\n.cyr-actions {\n    display: flex;\n    align-items: center;\n    flex-wrap: wrap;\n    gap: 22px;\n    margin-top: 34px;\n}\n\n.cyr-primary-btn {\n    display: inline-block;\n    padding: 16px 24px;\n    color: #142014 !important;\n    background: linear-gradient(110deg,#A6D84D,#D0EF78);\n    border-radius: 5px;\n    font-size: 13px;\n    font-weight: 700;\n    box-shadow: 0 12px 35px rgba(103,151,54,.2);\n    transition: .3s;\n}\n\n.cyr-primary-btn:hover {\n    transform: translateY(-4px);\n    box-shadow: 0 15px 40px rgba(103,151,54,.35);\n}\n\n.cyr-text-link {\n    color: #E4EBDD !important;\n    font-size: 13px;\n    font-weight: 600;\n}\n\n.cyr-hero-visual {\n    width: 47%;\n    position: relative;\n}\n\n.cyr-hero-visual img {\n    display: block;\n    width: 100%;\n    height: 440px;\n    object-fit: cover;\n    border-radius: 4px;\n    filter: brightness(.83);\n}\n\n.cyr-visual-glow {\n    position: absolute;\n    width: 180px;\n    height: 180px;\n    background: #83B94A;\n    filter: blur(110px);\n    opacity: .35;\n    right: -20px;\n    bottom: -25px;\n    z-index: -1;\n}\n\n.cyr-image-label {\n    position: absolute;\n    bottom: 18px;\n    left: 18px;\n    padding: 12px 16px;\n    background: rgba(10,18,12,.86);\n    border-left: 2px solid #B7E65C;\n    color: #FFFFFF;\n    font-size: 11px;\n    letter-spacing: 1px;\n}\n\n.cyr-hero-bottom {\n    margin-top: 75px;\n    padding-top: 24px;\n    border-top: 1px solid rgba(255,255,255,.12);\n    display: flex;\n    justify-content: space-between;\n    gap: 20px;\n    flex-wrap: wrap;\n}\n\n.cyr-hero-bottom span {\n    color: #A9B5A3;\n    font-size: 11px;\n    letter-spacing: 2px;\n}\n\n/* INTRO */\n\n.cyr-intro {\n    padding: 105px 0;\n    background:\n        radial-gradient(ellipse at 90% 50%, rgba(91,135,57,.13), transparent 38%),\n        #111A13 !important;\n}\n\n.cyr-intro-layout {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 55px;\n}\n\n.cyr-intro-title {\n    width: 55%;\n}\n\n.cyr-intro-title h2 {\n    font-size: 43px;\n    line-height: 1.2;\n    letter-spacing: -2px;\n    margin: 20px 0;\n    color: #FFFFFF;\n}\n\n.cyr-intro-text {\n    width: 40%;\n}\n\n.cyr-intro-text p {\n    color: #B5C0B0;\n    font-size: 15px;\n    line-height: 1.9;\n}\n\n/* SERVICES */\n\n.cyr-services {\n    padding: 110px 0;\n    background: #0B120D !important;\n    position: relative;\n}\n\n.cyr-section-top {\n    display: flex;\n    justify-content: space-between;\n    align-items: end;\n    gap: 30px;\n    margin-bottom: 55px;\n}\n\n.cyr-section-top h2 {\n    color: #FFFFFF;\n    font-size: 45px;\n    line-height: 1.15;\n    letter-spacing: -2px;\n    margin: 16px 0 0;\n}\n\n.cyr-section-top p {\n    max-width: 350px;\n    color: #A9B5A3;\n    font-size: 14px;\n    line-height: 1.8;\n}\n\n.cyr-service-grid {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 18px;\n}\n\n.cyr-service-card {\n    position: relative;\n    width: calc(50% - 9px);\n    min-height: 260px;\n    padding: 34px;\n    background: linear-gradient(140deg,#1A281D,#101A14) !important;\n    border: 1px solid rgba(183,230,92,.13);\n    overflow: hidden;\n    transition: .35s;\n}\n\n.cyr-service-card:after {\n    content: \"\";\n    position: absolute;\n    width: 170px;\n    height: 170px;\n    right: -75px;\n    top: -80px;\n    border: 1px solid rgba(183,230,92,.16);\n    border-radius: 50%;\n    transition: .4s;\n}\n\n.cyr-service-card:hover {\n    transform: translateY(-7px);\n    border-color: rgba(183,230,92,.55);\n    background: linear-gradient(140deg,#263829,#142018) !important;\n}\n\n.cyr-service-number {\n    color: #B7E65C;\n    font-size: 12px;\n    letter-spacing: 2px;\n}\n\n.cyr-service-card h3 {\n    color: #FFFFFF;\n    font-size: 23px;\n    margin: 27px 0 12px;\n}\n\n.cyr-service-card p {\n    color: #B5C0B0;\n    font-size: 14px;\n    line-height: 1.8;\n    max-width: 420px;\n    margin: 0;\n}\n\n.cyr-service-arrow {\n    display: inline-block;\n    margin-top: 22px;\n    color: #C5ED79;\n    font-size: 20px;\n}\n\n/* FEATURE */\n\n.cyr-feature {\n    padding: 105px 0;\n    background:\n        radial-gradient(ellipse at 15% 50%, rgba(91,135,57,.16), transparent 40%),\n        #121D15 !important;\n}\n\n.cyr-feature-layout {\n    display: flex;\n    align-items: center;\n    gap: 65px;\n}\n\n.cyr-feature-visual {\n    width: 48%;\n    position: relative;\n}\n\n.cyr-feature-visual img {\n    display: block;\n    width: 100%;\n    height: 390px;\n    object-fit: cover;\n    filter: brightness(.8);\n}\n\n.cyr-feature-copy {\n    width: 52%;\n}\n\n.cyr-feature-copy h2 {\n    color: #FFFFFF;\n    font-size: 43px;\n    line-height: 1.17;\n    letter-spacing: -2px;\n    margin: 18px 0;\n}\n\n.cyr-feature-copy p {\n    color: #B5C0B0;\n    font-size: 14px;\n    line-height: 1.9;\n}\n\n.cyr-feature-points {\n    margin-top: 28px;\n}\n\n.cyr-feature-point {\n    display: flex;\n    align-items: flex-start;\n    gap: 14px;\n    padding: 15px 0;\n    border-bottom: 1px solid rgba(255,255,255,.1);\n}\n\n.cyr-check {\n    color: #C5ED79;\n    font-size: 17px;\n}\n\n.cyr-feature-point strong {\n    color: #FFFFFF;\n    font-size: 14px;\n}\n\n.cyr-feature-point p {\n    margin: 5px 0 0;\n    font-size: 12px;\n}\n\n/* PROCESS */\n\n.cyr-process {\n    padding: 110px 0;\n    background: #0B120D !important;\n}\n\n.cyr-process-heading {\n    text-align: center;\n    max-width: 650px;\n    margin: 0 auto 60px;\n}\n\n.cyr-process-heading h2 {\n    color: #FFFFFF;\n    font-size: 43px;\n    letter-spacing: -2px;\n    margin: 18px 0;\n}\n\n.cyr-process-heading p {\n    color: #B5C0B0;\n    font-size: 14px;\n    line-height: 1.8;\n}\n\n.cyr-process-grid {\n    display: flex;\n    gap: 18px;\n}\n\n.cyr-process-item {\n    flex: 1;\n    padding: 28px 22px;\n    background: #162218 !important;\n    border-top: 2px solid #8FB94C;\n}\n\n.cyr-process-item span {\n    color: #C5ED79;\n    font-size: 12px;\n    letter-spacing: 2px;\n}\n\n.cyr-process-item h3 {\n    color: #FFFFFF;\n    font-size: 19px;\n    margin: 22px 0 12px;\n}\n\n.cyr-process-item p {\n    color: #B5C0B0;\n    font-size: 13px;\n    line-height: 1.8;\n}\n\n/* CONTACT */\n\n.cyr-contact {\n    padding: 100px 0;\n    background:\n        radial-gradient(ellipse at 50% 100%, rgba(91,135,57,.34), transparent 55%),\n        linear-gradient(130deg,#19251A,#101A14) !important;\n    text-align: center;\n    position: relative;\n}\n\n.cyr-contact-inner {\n    max-width: 750px;\n    margin: auto;\n}\n\n.cyr-contact h2 {\n    color: #FFFFFF;\n    font-size: 51px;\n    line-height: 1.13;\n    letter-spacing: -2.5px;\n    margin: 20px 0;\n}\n\n.cyr-contact p {\n    color: #B5C0B0;\n    font-size: 15px;\n    line-height: 1.9;\n    margin-bottom: 30px;\n}\n\n/* FOOTER */\n\n.cyr-footer {\n    padding: 35px 0;\n    background: #080F0A !important;\n    border-top: 1px solid rgba(255,255,255,.08);\n}\n\n.cyr-footer-inner {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    flex-wrap: wrap;\n    gap: 20px;\n}\n\n.cyr-footer strong {\n    color: #FFFFFF;\n    font-size: 15px;\n    letter-spacing: 1px;\n}\n\n.cyr-footer p {\n    color: #879483;\n    font-size: 12px;\n    margin: 0;\n}\n\n/* RESPONSIVE */\n\n@media (max-width: 900px) {\n    .cyr-hero-copy h1 {\n        font-size: 52px;\n    }\n\n    .cyr-section-top h2,\n    .cyr-feature-copy h2 {\n        font-size: 37px;\n    }\n\n    .cyr-hero-layout,\n    .cyr-feature-layout {\n        gap: 30px;\n    }\n}\n\n@media (max-width: 700px) {\n    .cyr-wrap {\n        width: 90%;\n    }\n\n    .cyr-announcement {\n        margin-top: 75px;\n    }\n\n    .cyr-announcement-inner {\n        min-height: 55px;\n        gap: 9px;\n        flex-wrap: wrap;\n    }\n\n    .cyr-announcement-label {\n        font-size: 9px;\n        letter-spacing: 1.5px;\n    }\n\n    .cyr-announcement-link {\n        font-size: 11px;\n        letter-spacing: .5px;\n        gap: 6px;\n    }\n\n    .cyr-announcement-divider {\n        height: 15px;\n    }\n\n    .cyr-hero {\n        padding: 75px 0 45px;\n    }\n\n    .cyr-hero-layout,\n    .cyr-intro-layout,\n    .cyr-feature-layout {\n        flex-direction: column;\n        align-items: stretch;\n    }\n\n    .cyr-hero-copy,\n    .cyr-hero-visual,\n    .cyr-intro-title,\n    .cyr-intro-text,\n    .cyr-feature-visual,\n    .cyr-feature-copy {\n        width: 100%;\n    }\n\n    .cyr-hero-copy h1 {\n        font-size: 46px;\n        letter-spacing: -2px;\n    }\n\n    .cyr-hero-visual img {\n        height: 300px;\n    }\n\n    .cyr-hero-bottom {\n        margin-top: 45px;\n    }\n\n    .cyr-intro,\n    .cyr-services,\n    .cyr-feature,\n    .cyr-process {\n        padding: 75px 0;\n    }\n\n    .cyr-intro-title h2,\n    .cyr-section-top h2,\n    .cyr-feature-copy h2,\n    .cyr-process-heading h2 {\n        font-size: 35px;\n    }\n\n    .cyr-section-top {\n        display: block;\n    }\n\n    .cyr-section-top p {\n        margin-top: 18px;\n    }\n\n    .cyr-service-card {\n        width: 100%;\n        min-height: 230px;\n    }\n\n    .cyr-feature-visual img {\n        height: 300px;\n    }\n\n    .cyr-process-grid {\n        flex-direction: column;\n    }\n\n    .cyr-contact {\n        padding: 75px 0;\n    }\n\n    .cyr-contact h2 {\n        font-size: 39px;\n    }\n\n    .cyr-footer-inner {\n        flex-direction: column;\n        align-items: flex-start;\n    }\n}\n</style>\n\n<div class=\"cyr-site\">\n\n    <!-- ANNOUNCEMENT -->\n    <section data-bs-version=\"5.1\" class=\"cyr-announcement\">\n        <div class=\"cyr-announcement-inner\">\n\n            <span class=\"cyr-announcement-label\">\n                SPECIAL ANNOUNCEMENT\n            </span>\n\n            <span class=\"cyr-announcement-divider\"></span>\n\n            <a href=\"digital-radio.html\" class=\"cyr-announcement-link\">\n                DIGITAL RADIO AT AFFORDABLE PRICE\n                <span>↗</span>\n            </a>\n\n        </div>\n    </section>\n\n    <!-- HERO -->\n    <section class=\"cyr-hero\">\n        <div class=\"cyr-wrap\">\n            <div class=\"cyr-hero-layout\">\n\n                <div class=\"cyr-hero-copy\">\n                    <span class=\"cyr-eyebrow\">Digital Solutions &amp; Technology</span>\n\n                    <h1>\n                        Give your business a\n                        <span class=\"cyr-gradient-text\">digital edge.</span>\n                    </h1>\n\n                    <p>\n                        We create professional websites, develop digital solutions\n                        and build reliable database systems that help businesses\n                        establish their presence and operate more effectively.\n                    </p>\n\n                    <div class=\"cyr-actions\">\n                        <a href=\"contact.html\" class=\"cyr-primary-btn\">\n                            Start a Project &nbsp; ↗\n                        </a>\n\n                        <a href=\"about.html\" class=\"cyr-text-link\">\n                            Discover What We Do ↓\n                        </a>\n                    </div>\n                </div>\n\n                <div class=\"cyr-hero-visual\">\n                    <img src=\"https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=1100&q=85\" alt=\"Professional web development workspace\">\n\n                    <div class=\"cyr-visual-glow\"></div>\n\n                    <div class=\"cyr-image-label\">\n                        DESIGN. DEVELOPMENT. DIGITAL SOLUTIONS.\n                    </div>\n                </div>\n\n            </div>\n\n            <div class=\"cyr-hero-bottom\">\n                <span>WEBSITE DESIGN</span>\n                <span>WEB DEVELOPMENT</span>\n                <span>DATABASE CREATION</span>\n                <span>DATABASE MANAGEMENT</span>\n            </div>\n        </div>\n    </section>\n\n    <!-- INTRODUCTION -->\n    <section class=\"cyr-intro\">\n        <div class=\"cyr-wrap\">\n            <div class=\"cyr-intro-layout\">\n\n                <div class=\"cyr-intro-title\">\n                    <span class=\"cyr-eyebrow\">More Than Just Technology</span>\n\n                    <h2>\n                        We turn digital ideas into\n                        <span class=\"cyr-gradient-text\">practical solutions.</span>\n                    </h2>\n                </div>\n\n                <div class=\"cyr-intro-text\">\n                    <p>\n                        Every business has a story to tell and goals to achieve.\n                        We help bring those goals closer through thoughtful\n                        website design, purposeful development and organised\n                        database solutions.\n                    </p>\n\n                    <p>\n                        Our focus is simple: understand what you need and\n                        create a digital solution that serves your purpose.\n                    </p>\n                </div>\n\n            </div>\n        </div>\n    </section>\n\n    <!-- SERVICES -->\n    <section class=\"cyr-services\" id=\"cyr-services\">\n        <div class=\"cyr-wrap\">\n\n            <div class=\"cyr-section-top\">\n                <div>\n                    <span class=\"cyr-eyebrow\">What We Do</span>\n                    <h2>Our areas of<br>expertise.</h2>\n                </div>\n\n                <p>\n                    From your first online presence to the systems that\n                    organise your information, we provide focused digital\n                    services for your needs.\n                </p>\n            </div>\n\n            <div class=\"cyr-service-grid\">\n\n                <div class=\"cyr-service-card\">\n                    <span class=\"cyr-service-number\">01 / WEBSITE DESIGN</span>\n                    <h3>Website Design</h3>\n                    <p>\n                        Make a strong first impression with a professional,\n                        visually engaging website designed to communicate\n                        your brand and connect with your audience.\n                    </p>\n                    <span class=\"cyr-service-arrow\">↗</span>\n                </div>\n\n                <div class=\"cyr-service-card\">\n                    <span class=\"cyr-service-number\">02 / WEB DEVELOPMENT</span>\n                    <h3>Web Development</h3>\n                    <p>\n                        Turn your ideas into functional digital experiences\n                        through carefully developed websites built around\n                        your business requirements.\n                    </p>\n                    <span class=\"cyr-service-arrow\">↗</span>\n                </div>\n\n                <div class=\"cyr-service-card\">\n                    <span class=\"cyr-service-number\">03 / DATABASE CREATION</span>\n                    <h3>Database Creation</h3>\n                    <p>\n                        Give your information a proper structure with\n                        organised databases designed to store, manage\n                        and retrieve important business data.\n                    </p>\n                    <span class=\"cyr-service-arrow\">↗</span>\n                </div>\n\n                <div class=\"cyr-service-card\">\n                    <span class=\"cyr-service-number\">04 / DATABASE MANAGEMENT</span>\n                    <h3>Database Management</h3>\n                    <p>\n                        Keep your business information organised and\n                        manageable through database maintenance,\n                        organisation and management solutions.\n                    </p>\n                    <span class=\"cyr-service-arrow\">↗</span>\n                </div>\n\n            </div>\n        </div>\n    </section>\n\n    <!-- VALUE PROPOSITION -->\n    <section class=\"cyr-feature\">\n        <div class=\"cyr-wrap\">\n            <div class=\"cyr-feature-layout\">\n\n                <div class=\"cyr-feature-visual\">\n                    <img src=\"https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=1000&q=85\" alt=\"Digital work and technology\">\n                </div>\n\n                <div class=\"cyr-feature-copy\">\n                    <span class=\"cyr-eyebrow\">Why Work With Us</span>\n\n                    <h2>\n                        Your goals deserve\n                        <span class=\"cyr-gradient-text\">the right approach.</span>\n                    </h2>\n\n                    <p>\n                        Choosing a digital service provider should be about\n                        more than getting something built. It should be about\n                        getting a solution that understands your needs.\n                    </p>\n\n                    <div class=\"cyr-feature-points\">\n\n                        <div class=\"cyr-feature-point\">\n                            <span class=\"cyr-check\">✦</span>\n                            <div>\n                                <strong>Solutions Built Around Your Needs</strong>\n                                <p>We focus on the requirements and purpose of your project.</p>\n                            </div>\n                        </div>\n\n                        <div class=\"cyr-feature-point\">\n                            <span class=\"cyr-check\">✦</span>\n                            <div>\n                                <strong>Attention to Detail</strong>\n                                <p>We value thoughtful design and organised development.</p>\n                            </div>\n                        </div>\n\n                        <div class=\"cyr-feature-point\">\n                            <span class=\"cyr-check\">✦</span>\n                            <div>\n                                <strong>Clear Communication</strong>\n                                <p>We believe in understanding your expectations throughout the project.</p>\n                            </div>\n                        </div>\n\n                    </div>\n                </div>\n\n            </div>\n        </div>\n    </section>\n\n    <!-- PROCESS -->\n    <section class=\"cyr-process\">\n        <div class=\"cyr-wrap\">\n\n            <div class=\"cyr-process-heading\">\n                <span class=\"cyr-eyebrow\">How We Work</span>\n\n                <h2>A clear path from idea to execution.</h2>\n\n                <p>\n                    Every successful project begins with understanding.\n                    Our process helps turn your requirements into a\n                    practical digital solution.\n                </p>\n            </div>\n\n            <div class=\"cyr-process-grid\">\n\n                <div class=\"cyr-process-item\">\n                    <span>01 / DISCOVER</span>\n                    <h3>Understand</h3>\n                    <p>\n                        We learn about your business, your objectives\n                        and what you want to achieve.\n                    </p>\n                </div>\n\n                <div class=\"cyr-process-item\">\n                    <span>02 / PLAN</span>\n                    <h3>Plan</h3>\n                    <p>\n                        We establish the project requirements and\n                        determine the right approach.\n                    </p>\n                </div>\n\n                <div class=\"cyr-process-item\">\n                    <span>03 / CREATE</span>\n                    <h3>Develop</h3>\n                    <p>\n                        We work on the design, development or\n                        database solution your project requires.\n                    </p>\n                </div>\n\n                <div class=\"cyr-process-item\">\n                    <span>04 / COMPLETE</span>\n                    <h3>Deliver</h3>\n                    <p>\n                        We present the completed work and help you\n                        understand your solution.\n                    </p>\n                </div>\n\n            </div>\n        </div>\n    </section>\n\n    <!-- CONTACT -->\n    <section class=\"cyr-contact\" id=\"cyr-contact\">\n        <div class=\"cyr-wrap\">\n            <div class=\"cyr-contact-inner\">\n\n                <span class=\"cyr-eyebrow\">Let's Create Something Valuable</span>\n\n                <h2>\n                    Have an idea?\n                    <span class=\"cyr-gradient-text\">Let's make it happen.</span>\n                </h2>\n\n                <p>\n                    Whether you need a professional website, a web\n                    development solution or a database system,\n                    let's discuss what you have in mind.\n                </p>\n\n                <a href=\"mailto:forwisdomswork@gmail.com\" class=\"cyr-primary-btn\">\n                    Discuss Your Project &nbsp; ↗\n                </a>\n\n            </div>\n        </div>\n    </section>\n\n    <!-- FOOTER -->\n    <footer class=\"cyr-footer\">\n        <div class=\"cyr-wrap\">\n            <div class=\"cyr-footer-inner\">\n\n                <strong>CY ROBINSON TECHNOLOGIES.</strong>\n\n                <p>\n                    © 2026 CY Robinson Technologies. All rights reserved.\n                </p>\n\n            </div>\n        </div>\n    </footer>\n\n</div>\n```",
