        {
          "alias": false,
          "_styles": {},
          "_name": "header09",
          "_sourceTheme": "startm5",
          "_customHTML": "```html\n<style>\n.cyr-contact-page {\n  --cyr-bg: #0B120D;\n  --cyr-bg2: #111A13;\n  --cyr-card: #1A281D;\n  --cyr-text: #F4F7F0;\n  --cyr-muted: #B5C0B0;\n  --cyr-accent: #C5ED79;\n  --cyr-border: rgba(197,237,121,.13);\n  background: var(--cyr-bg);\n  color: var(--cyr-text);\n  font-family: inherit;\n  overflow: hidden;\n}\n.cyr-contact-page * { box-sizing: border-box; }\n.cyr-contact-page .cyr-container {\n  width: min(1160px, 90%);\n  margin: 0 auto;\n}\n.cyr-contact-page .cyr-eyebrow {\n  color: #C5ED79;\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 2.5px;\n  text-transform: uppercase;\n  margin-bottom: 16px;\n}\n\n/* ANNOUNCEMENT */\n.cyr-contact-page .cyr-announcement {\n  margin-top: 90px;\n  padding: 15px 20px;\n  background:\n    linear-gradient(100deg,rgba(166,216,77,.10),rgba(94,139,65,.08)),\n    #111A13;\n  border-top: 1px solid rgba(197,237,121,.20);\n  border-bottom: 1px solid rgba(197,237,121,.20);\n}\n.cyr-contact-page .cyr-announcement-inner {\n  width: min(1160px,90%);\n  margin: auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 18px;\n  flex-wrap: wrap;\n}\n.cyr-contact-page .cyr-announcement-label {\n  color: #C5ED79;\n  font-size: 10px;\n  font-weight: 800;\n  letter-spacing: 2px;\n}\n.cyr-contact-page .cyr-announcement-divider {\n  width: 1px;\n  height: 19px;\n  background: rgba(255,255,255,.25);\n}\n.cyr-contact-page .cyr-announcement-link {\n  display: inline-flex;\n  align-items: center;\n  gap: 12px;\n  color: #F4F7F0 !important;\n  font-size: 13px;\n  font-weight: 750;\n  letter-spacing: 1.1px;\n  text-decoration: none !important;\n  transition: .25s ease;\n}\n.cyr-contact-page .cyr-announcement-link span {\n  color: #C5ED79;\n  font-size: 19px;\n  transition: transform .25s ease;\n}\n.cyr-contact-page .cyr-announcement-link:hover {\n  color: #D8F29B !important;\n}\n.cyr-contact-page .cyr-announcement-link:hover span {\n  transform: translate(3px,-3px);\n}\n\n/* HERO */\n.cyr-contact-page .cyr-contact-hero {\n  padding: 95px 0 80px;\n  background:\n    radial-gradient(ellipse at 80% 15%, rgba(143,198,90,.17), transparent 38%),\n    #0B120D;\n}\n.cyr-contact-page .cyr-hero-content { max-width: 820px; }\n.cyr-contact-page .cyr-contact-hero h1 {\n  color: #fff;\n  font-size: clamp(43px, 6.5vw, 72px);\n  line-height: 1.07;\n  letter-spacing: -2.5px;\n  font-weight: 750;\n  margin: 0 0 22px;\n}\n.cyr-contact-page .cyr-contact-hero h1 span {\n  background: linear-gradient(110deg,#C5ED79,#8FC65A,#D8F29B);\n  -webkit-background-clip: text;\n  background-clip: text;\n  -webkit-text-fill-color: transparent;\n}\n.cyr-contact-page .cyr-contact-hero p {\n  color: #B5C0B0;\n  font-size: 16px;\n  line-height: 1.85;\n  max-width: 650px;\n  margin: 0;\n}\n\n/* CONTACT AREA */\n.cyr-contact-page .cyr-contact-main {\n  padding: 85px 0 100px;\n  background: #111A13;\n}\n.cyr-contact-page .cyr-contact-grid {\n  display: grid;\n  grid-template-columns: .8fr 1.2fr;\n  gap: 55px;\n  align-items: start;\n}\n.cyr-contact-page .cyr-contact-info h2 {\n  color: #fff;\n  font-size: clamp(30px, 3.5vw, 40px);\n  line-height: 1.2;\n  letter-spacing: -1px;\n  margin: 0 0 18px;\n}\n.cyr-contact-page .cyr-contact-info > p {\n  color: #B5C0B0;\n  font-size: 15px;\n  line-height: 1.8;\n  margin: 0 0 30px;\n}\n.cyr-contact-page .cyr-info-card {\n  padding: 20px 0;\n  border-top: 1px solid rgba(197,237,121,.14);\n}\n.cyr-contact-page .cyr-info-label {\n  display: block;\n  color: #9BAA96;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 1.6px;\n  text-transform: uppercase;\n  margin-bottom: 9px;\n}\n.cyr-contact-page .cyr-info-value {\n  color: #F0F4EA;\n  font-size: 15px;\n  line-height: 1.8;\n  font-weight: 500;\n  overflow-wrap: anywhere;\n}\n.cyr-contact-page .cyr-info-value a {\n  color: #C5ED79 !important;\n  text-decoration: none !important;\n}\n.cyr-contact-page .cyr-info-value a:hover {\n  color: #D8F29B !important;\n}\n\n/* FORM PANEL */\n.cyr-contact-page .cyr-form-card {\n  padding: 38px;\n  background: #F8FAF5;\n  border: 1px solid #DDE5D6;\n  border-radius: 12px;\n  box-shadow: 0 25px 65px rgba(0,0,0,.25);\n}\n.cyr-contact-page .cyr-form-card h3 {\n  color: #17251A;\n  font-size: 27px;\n  font-weight: 750;\n  margin: 0 0 9px;\n}\n.cyr-contact-page .cyr-form-description {\n  color: #687568;\n  font-size: 14px;\n  line-height: 1.7;\n  margin: 0 0 27px;\n}\n.cyr-contact-page .cyr-form-row,\n.cyr-contact-page .cyr-row {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 16px;\n}\n.cyr-contact-page .cyr-form-group { margin-bottom: 19px; }\n.cyr-contact-page .cyr-form-group label {\n  display: block;\n  color: #263729;\n  font-size: 13px;\n  font-weight: 700;\n  margin-bottom: 8px;\n}\n.cyr-contact-page .cyr-form-group input,\n.cyr-contact-page .cyr-form-group select,\n.cyr-contact-page .cyr-form-group textarea {\n  display: block;\n  width: 100%;\n  min-height: 49px;\n  padding: 13px 14px;\n  border: 1px solid #D8E0D3;\n  border-radius: 6px;\n  outline: none;\n  background: #F0F4EC;\n  color: #17251A;\n  font-family: inherit;\n  font-size: 14px;\n  transition: border-color .2s ease, box-shadow .2s ease;\n}\n.cyr-contact-page .cyr-form-group input::placeholder,\n.cyr-contact-page .cyr-form-group textarea::placeholder {\n  color: #929D8E;\n}\n.cyr-contact-page .cyr-form-group select { color: #536452; }\n.cyr-contact-page .cyr-form-group select option {\n  background: #fff;\n  color: #17251A;\n}\n.cyr-contact-page .cyr-form-group textarea {\n  min-height: 135px;\n  resize: vertical;\n}\n.cyr-contact-page .cyr-form-group input:focus,\n.cyr-contact-page .cyr-form-group select:focus,\n.cyr-contact-page .cyr-form-group textarea:focus {\n  border-color: #8FBF4D;\n  box-shadow: 0 0 0 3px rgba(143,191,77,.15);\n  background: #fff;\n}\n.cyr-contact-page .cyr-submit-btn {\n  width: 100%;\n  min-height: 53px;\n  border: 0;\n  border-radius: 6px;\n  background: linear-gradient(110deg,#A6D84D,#D0EF78);\n  color: #172313;\n  font-family: inherit;\n  font-size: 14px;\n  font-weight: 800;\n  cursor: pointer;\n  transition: .25s ease;\n}\n.cyr-contact-page .cyr-submit-btn:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 10px 25px rgba(143,191,77,.25);\n}\n.cyr-contact-page .cyr-submit-btn:disabled {\n  opacity: .7;\n  cursor: wait;\n  transform: none;\n  box-shadow: none;\n}\n.cyr-contact-page .cyr-form-note {\n  color: #899486;\n  font-size: 11px;\n  line-height: 1.6;\n  text-align: center;\n  margin: 13px 0 0;\n}\n.cyr-contact-page .cyr-form-status {\n  display: none;\n  padding: 12px 14px;\n  margin-top: 16px;\n  border-radius: 6px;\n  font-size: 13px;\n  line-height: 1.6;\n}\n.cyr-contact-page .cyr-form-status.success {\n  display: block;\n  color: #17633B;\n  background: #E9F8EF;\n  border: 1px solid #B9E7CA;\n}\n.cyr-contact-page .cyr-form-status.error {\n  display: block;\n  color: #9B2525;\n  background: #FFF0F0;\n  border: 1px solid #F0C5C5;\n}\n\n/* SHORT CLOSING SECTION */\n.cyr-contact-page .cyr-contact-cta {\n  padding: 75px 0;\n  background: #0B120D;\n}\n.cyr-contact-page .cyr-cta-inner {\n  text-align: center;\n  padding: 55px 25px;\n  border-radius: 13px;\n  background:\n    radial-gradient(ellipse at 50% 0%, rgba(143,198,90,.19), transparent 65%),\n    #162218;\n  border: 1px solid rgba(197,237,121,.15);\n}\n.cyr-contact-page .cyr-cta-inner h2 {\n  color: #fff;\n  font-size: clamp(29px, 4vw, 42px);\n  line-height: 1.2;\n  margin: 0 0 13px;\n}\n.cyr-contact-page .cyr-cta-inner p {\n  color: #B5C0B0;\n  font-size: 14px;\n  line-height: 1.7;\n  max-width: 550px;\n  margin: 0 auto;\n}\n\n/* FOOTER */\n.cyr-contact-page .cyr-contact-footer {\n  padding: 27px 0;\n  background: #0B120D;\n  border-top: 1px solid rgba(197,237,121,.12);\n}\n.cyr-contact-page .cyr-footer-inner {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 18px;\n  flex-wrap: wrap;\n}\n.cyr-contact-page .cyr-footer-brand {\n  color: #fff;\n  font-size: 13px;\n  font-weight: 700;\n  letter-spacing: 1px;\n}\n.cyr-contact-page .cyr-footer-copy {\n  color: #899486;\n  font-size: 12px;\n  margin: 0;\n}\n\n/* MOBILE */\n@media (max-width: 767px) {\n  .cyr-contact-page .cyr-announcement {\n    margin-top: 75px;\n    padding: 13px 12px;\n  }\n  .cyr-contact-page .cyr-announcement-inner { gap: 9px; }\n  .cyr-contact-page .cyr-announcement-label { font-size: 9px; }\n  .cyr-contact-page .cyr-announcement-divider { height: 15px; }\n  .cyr-contact-page .cyr-announcement-link {\n    font-size: 11px;\n    letter-spacing: .5px;\n    gap: 7px;\n  }\n  .cyr-contact-page .cyr-contact-hero { padding: 70px 0 60px; }\n  .cyr-contact-page .cyr-contact-hero h1 { letter-spacing: -1.7px; }\n  .cyr-contact-page .cyr-contact-main { padding: 65px 0; }\n  .cyr-contact-page .cyr-contact-grid {\n    grid-template-columns: 1fr;\n    gap: 38px;\n  }\n  .cyr-contact-page .cyr-form-card { padding: 26px 19px; }\n  .cyr-contact-page .cyr-row {\n    grid-template-columns: 1fr;\n    gap: 0;\n  }\n  .cyr-contact-page .cyr-contact-cta { padding: 55px 0; }\n  .cyr-contact-page .cyr-cta-inner { padding: 42px 20px; }\n}\n</style>\n\n<div class=\"cyr-contact-page\">\n\n  <!-- ANNOUNCEMENT -->\n  <section data-bs-version=\"5.1\" class=\"cyr-announcement\">\n    <div class=\"cyr-announcement-inner\">\n      <span class=\"cyr-announcement-label\">SPECIAL ANNOUNCEMENT</span>\n      <span class=\"cyr-announcement-divider\"></span>\n      <a href=\"digital-radio.html\" class=\"cyr-announcement-link\">\n        DIGITAL RADIO AT AFFORDABLE PRICE\n        <span>↗</span>\n      </a>\n    </div>\n  </section>\n\n  <!-- HERO -->\n  <section class=\"cyr-contact-hero\">\n    <div class=\"cyr-container\">\n      <div class=\"cyr-hero-content\">\n        <div class=\"cyr-eyebrow\">CONTACT US</div>\n        <h1>Let's talk about your <span>next project.</span></h1>\n        <p>\n          Have a website, development or database project in mind? Tell us what you need. We would be glad to hear from you.\n        </p>\n      </div>\n    </div>\n  </section>\n\n  <!-- CONTACT DETAILS AND FORM -->\n  <section class=\"cyr-contact-main\" id=\"cyr-contact-form\">\n    <div class=\"cyr-container\">\n      <div class=\"cyr-contact-grid\">\n\n        <div class=\"cyr-contact-info\">\n          <div class=\"cyr-eyebrow\">GET IN TOUCH</div>\n          <h2>Let's make your idea happen.</h2>\n          <p>\n            Share your requirements with us and let's discuss the right digital solution for your business.\n          </p>\n\n          <div class=\"cyr-info-card\">\n            <span class=\"cyr-info-label\">Email Address</span>\n            <div class=\"cyr-info-value\">\n              <a href=\"mailto:forwisdomswork@gmail.com\">forwisdomswork@gmail.com</a>\n            </div>\n          </div>\n\n          <div class=\"cyr-info-card\">\n            <span class=\"cyr-info-label\">Our Services</span>\n            <div class=\"cyr-info-value\">\n              Website Design<br>\n              Web Development<br>\n              Database Creation<br>\n              Database Management\n            </div>\n          </div>\n\n          <div class=\"cyr-info-card\">\n            <span class=\"cyr-info-label\">Our Focus</span>\n            <div class=\"cyr-info-value\">\n              Practical digital solutions for businesses.\n            </div>\n          </div>\n        </div>\n\n        <!-- WEB3FORMS CONTACT FORM -->\n        <div class=\"cyr-form-card\">\n          <h3>Send us an enquiry.</h3>\n          <p class=\"cyr-form-description\">\n            Fill in the details below and we will receive your message by email.\n          </p>\n\n          <form id=\"cyr-contact-form-web3\" novalidate>\n\n            <input type=\"hidden\" name=\"access_key\" value=\"feab6b64-11df-4d1f-b170-6e18bb974f90\">\n            <input type=\"hidden\" name=\"subject\" value=\"New Project Enquiry - CY Robinson Technologies\">\n            <input type=\"hidden\" name=\"from_name\" value=\"CY Robinson Technologies\">\n\n            <!-- Spam protection -->\n            <input type=\"checkbox\" name=\"botcheck\" style=\"display:none\">\n\n            <div class=\"cyr-row\">\n              <div class=\"cyr-form-group mb-3\">\n                <label for=\"cyr-name\">Full Name *</label>\n                <input type=\"text\" id=\"cyr-name\" name=\"name\" placeholder=\"Your full name\" autocomplete=\"name\" required>\n              </div>\n\n              <div class=\"cyr-form-group mb-3\">\n                <label for=\"cyr-email\">Email Address *</label>\n                <input type=\"email\" id=\"cyr-email\" name=\"email\" placeholder=\"Your email address\" autocomplete=\"email\" required>\n              </div>\n            </div>\n\n            <div class=\"cyr-form-group mb-3\">\n              <label for=\"cyr-service\">Service Required *</label>\n              <select id=\"cyr-service\" name=\"Service Required\" required>\n                <option value disabled selected>Select a service</option>\n                <option value=\"Website Design\">Website Design</option>\n                <option value=\"Web Development\">Web Development</option>\n                <option value=\"Database Creation\">Database Creation</option>\n                <option value=\"Database Management\">Database Management</option>\n                <option value=\"Multiple Services\">Multiple Services</option>\n                <option value=\"Digital Radio Enquiries\">Digital Radio Enquiries</option>\n                <option value=\"Not Sure Yet\">Not Sure Yet</option>\n              </select>\n            </div>\n\n            <div class=\"cyr-form-group mb-3\">\n              <label for=\"cyr-subject\">Subject *</label>\n              <input type=\"text\" id=\"cyr-subject\" name=\"Enquiry Subject\" placeholder=\"Enquiry subject\" required>\n            </div>\n\n            <div class=\"cyr-form-group mb-3\">\n              <label for=\"cyr-message\">Message *</label>\n              <textarea id=\"cyr-message\" name=\"Project Details\" placeholder=\"Briefly describe your project or enquiry...\" required></textarea>\n            </div>\n\n            <button type=\"submit\" class=\"cyr-submit-btn\" id=\"cyr-submit-btn\">\n              Send Enquiry →\n            </button>\n\n            <div class=\"cyr-form-status\" id=\"cyr-form-status\" role=\"status\" aria-live=\"polite\"></div>\n\n            <p class=\"cyr-form-note\">\n              Your information will only be used to respond to your enquiry.\n            </p>\n          </form>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- CLOSING -->\n  <section class=\"cyr-contact-cta\">\n    <div class=\"cyr-container\">\n      <div class=\"cyr-cta-inner\">\n        <div class=\"cyr-eyebrow\">CY ROBINSON TECHNOLOGIES</div>\n        <h2>Your next project starts with a conversation.</h2>\n        <p>We look forward to hearing what you have in mind.</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- FOOTER -->\n  <footer class=\"cyr-contact-footer\">\n    <div class=\"cyr-container\">\n      <div class=\"cyr-footer-inner\">\n        <div class=\"cyr-footer-brand\">CY ROBINSON TECHNOLOGIES</div>\n        <p class=\"cyr-footer-copy\">© 2026 CY Robinson Technologies. All rights reserved.</p>\n      </div>\n    </div>\n  </footer>\n\n</div>\n\n<script>\n(function () {\n  const form = document.getElementById(\"cyr-contact-form-web3\");\n\n  if (!form || form.dataset.web3Ready === \"true\") return;\n  form.dataset.web3Ready = \"true\";\n\n  const button = document.getElementById(\"cyr-submit-btn\");\n  const status = document.getElementById(\"cyr-form-status\");\n  const originalButtonText = button.textContent;\n\n  function showMessage(message, type) {\n    status.textContent = message;\n    status.className = \"cyr-form-status \" + type;\n  }\n\n  form.addEventListener(\"submit\", async function (event) {\n    event.preventDefault();\n\n    if (!form.reportValidity()) return;\n\n    button.disabled = true;\n    button.textContent = \"Sending...\";\n    status.className = \"cyr-form-status\";\n    status.textContent = \"\";\n\n    try {\n      const response = await fetch(\"https://api.web3forms.com/submit\", {\n        method: \"POST\",\n        headers: {\n          Accept: \"application/json\"\n        },\n        body: new FormData(form)\n      });\n\n      const result = await response.json();\n\n      if (response.ok && result.success) {\n        showMessage(\n          \"Thank you! Your enquiry has been sent successfully. We will get back to you soon.\",\n          \"success\"\n        );\n        form.reset();\n      } else {\n        showMessage(\n          result.message || \"We could not send your enquiry. Please try again later.\",\n          \"error\"\n        );\n      }\n\n    } catch (error) {\n      showMessage(\n        \"A connection error occurred. Please check your internet connection and try again.\",\n        \"error\"\n      );\n    } finally {\n      button.disabled = false;\n      button.textContent = originalButtonText;\n    }\n  });\n})();\n</script>\n```",
