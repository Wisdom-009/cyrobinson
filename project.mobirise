          "_name": "header09",
          "_sourceTheme": "startm5",
          "_customHTML": "\r\n\r\n```html\r\n<style>\r\n.cyr-services-page {\r\n  --cyr-bg: #0B120D;\r\n  --cyr-bg2: #111A13;\r\n  --cyr-card: #1A281D;\r\n  --cyr-text: #FFFFFF;\r\n  --cyr-muted: #B5C0B0;\r\n  --cyr-accent: #C5ED79;\r\n  --cyr-border: rgba(197,237,121,.12);\r\n  background: var(--cyr-bg);\r\n  color: var(--cyr-text);\r\n  font-family: inherit;\r\n  overflow: hidden;\r\n}\r\n\r\n.cyr-services-page * {\r\n  box-sizing: border-box;\r\n}\r\n\r\n.cyr-services-page img {\r\n  display: block;\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n}\r\n\r\n.cyr-services-page .cyr-container {\r\n  width: min(1160px, 90%);\r\n  margin: 0 auto;\r\n}\r\n\r\n/* ANNOUNCEMENT */\r\n.cyr-services-page .cyr-announcement {\r\n  margin-top: 90px;\r\n  padding: 15px 20px;\r\n  background:\r\n    linear-gradient(100deg,rgba(166,216,77,.10),rgba(91,139,65,.09)),\r\n    #101A12;\r\n  border-top: 1px solid rgba(197,237,121,.20);\r\n  border-bottom: 1px solid rgba(197,237,121,.20);\r\n}\r\n\r\n.cyr-services-page .cyr-announcement-inner {\r\n  width: min(1160px,90%);\r\n  margin: auto;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 18px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.cyr-services-page .cyr-announcement-label {\r\n  color: #C5ED79;\r\n  font-size: 10px;\r\n  font-weight: 800;\r\n  letter-spacing: 2px;\r\n}\r\n\r\n.cyr-services-page .cyr-announcement-divider {\r\n  width: 1px;\r\n  height: 19px;\r\n  background: rgba(255,255,255,.25);\r\n}\r\n\r\n.cyr-services-page .cyr-announcement-link {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  color: #F4F8EF !important;\r\n  font-size: 13px;\r\n  font-weight: 750;\r\n  letter-spacing: 1.1px;\r\n  text-decoration: none !important;\r\n  transition: .25s ease;\r\n}\r\n\r\n.cyr-services-page .cyr-announcement-link span {\r\n  color: #C5ED79;\r\n  font-size: 19px;\r\n  transition: transform .25s ease;\r\n}\r\n\r\n.cyr-services-page .cyr-announcement-link:hover {\r\n  color: #D0EF78 !important;\r\n}\r\n\r\n.cyr-services-page .cyr-announcement-link:hover span {\r\n  transform: translate(3px,-3px);\r\n}\r\n\r\n.cyr-services-page .cyr-eyebrow {\r\n  color: #C5ED79;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  letter-spacing: 2.5px;\r\n  text-transform: uppercase;\r\n  margin-bottom: 18px;\r\n}\r\n\r\n.cyr-services-page .cyr-section-heading {\r\n  font-size: clamp(32px, 4.5vw, 48px);\r\n  line-height: 1.15;\r\n  letter-spacing: -1.5px;\r\n  font-weight: 700;\r\n  color: #FFFFFF;\r\n  margin: 0 0 20px;\r\n}\r\n\r\n.cyr-services-page .cyr-section-description {\r\n  color: var(--cyr-muted);\r\n  font-size: 16px;\r\n  line-height: 1.85;\r\n  max-width: 650px;\r\n  margin: 0;\r\n}\r\n\r\n/* HERO */\r\n.cyr-services-page .cyr-services-hero {\r\n  position: relative;\r\n  padding: 110px 0 100px;\r\n  background:\r\n    radial-gradient(ellipse at 78% 20%, rgba(166,216,77,.15), transparent 38%),\r\n    radial-gradient(ellipse at 10% 90%, rgba(76,125,68,.13), transparent 40%),\r\n    #0B120D;\r\n}\r\n\r\n.cyr-services-page .cyr-hero-grid {\r\n  display: grid;\r\n  grid-template-columns: 1.05fr .95fr;\r\n  gap: 65px;\r\n  align-items: center;\r\n}\r\n\r\n.cyr-services-page .cyr-hero-copy h1 {\r\n  color: #fff;\r\n  font-size: clamp(43px, 6vw, 70px);\r\n  line-height: 1.04;\r\n  letter-spacing: -2.8px;\r\n  font-weight: 750;\r\n  margin: 0 0 25px;\r\n}\r\n\r\n.cyr-services-page .cyr-hero-copy h1 span {\r\n  background: linear-gradient(100deg,#C5ED79,#8FC65A,#D8F29B);\r\n  -webkit-background-clip: text;\r\n  background-clip: text;\r\n  color: transparent;\r\n}\r\n\r\n.cyr-services-page .cyr-hero-copy p {\r\n  color: #B5C0B0;\r\n  font-size: 17px;\r\n  line-height: 1.85;\r\n  max-width: 540px;\r\n  margin: 0 0 34px;\r\n}\r\n\r\n.cyr-services-page .cyr-hero-actions {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 25px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.cyr-services-page .cyr-primary-btn {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 15px 25px;\r\n  border-radius: 7px;\r\n  background: linear-gradient(110deg,#A6D84D,#D0EF78);\r\n  color: #14200F !important;\r\n  font-size: 14px;\r\n  font-weight: 700;\r\n  text-decoration: none !important;\r\n  transition: .25s ease;\r\n}\r\n\r\n.cyr-services-page .cyr-primary-btn:hover {\r\n  transform: translateY(-3px);\r\n  box-shadow: 0 12px 30px rgba(166,216,77,.20);\r\n}\r\n\r\n.cyr-services-page .cyr-text-link {\r\n  color: #E0E9D9 !important;\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n  text-decoration: none !important;\r\n}\r\n\r\n.cyr-services-page .cyr-text-link:hover {\r\n  color: #C5ED79 !important;\r\n}\r\n\r\n.cyr-services-page .cyr-hero-image {\r\n  position: relative;\r\n  min-height: 430px;\r\n  border-radius: 15px;\r\n  overflow: hidden;\r\n  border: 1px solid rgba(197,237,121,.15);\r\n  box-shadow: 0 30px 80px rgba(0,0,0,.35);\r\n}\r\n\r\n.cyr-services-page .cyr-hero-image img {\r\n  position: absolute;\r\n  inset: 0;\r\n}\r\n\r\n.cyr-services-page .cyr-image-caption {\r\n  position: absolute;\r\n  left: 20px;\r\n  right: 20px;\r\n  bottom: 20px;\r\n  padding: 17px 20px;\r\n  background: rgba(11,18,13,.86);\r\n  border: 1px solid rgba(197,237,121,.16);\r\n  border-radius: 9px;\r\n  backdrop-filter: blur(12px);\r\n}\r\n\r\n.cyr-services-page .cyr-image-caption strong {\r\n  display: block;\r\n  color: #fff;\r\n  font-size: 14px;\r\n  margin-bottom: 5px;\r\n}\r\n\r\n.cyr-services-page .cyr-image-caption span {\r\n  color: #B5C0B0;\r\n  font-size: 12px;\r\n}\r\n\r\n/* INTRODUCTION */\r\n.cyr-services-page .cyr-services-intro {\r\n  padding: 100px 0 65px;\r\n  background: #111A13;\r\n  text-align: center;\r\n}\r\n\r\n.cyr-services-page .cyr-services-intro .cyr-section-description {\r\n  margin: 0 auto;\r\n}\r\n\r\n/* SERVICE DETAILS */\r\n.cyr-services-page .cyr-service-list {\r\n  padding: 30px 0 100px;\r\n  background: #111A13;\r\n}\r\n\r\n.cyr-services-page .cyr-service-row {\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr;\r\n  align-items: center;\r\n  gap: 65px;\r\n  padding: 65px 0;\r\n  border-bottom: 1px solid var(--cyr-border);\r\n}\r\n\r\n.cyr-services-page .cyr-service-row:last-child {\r\n  border-bottom: 0;\r\n}\r\n\r\n.cyr-services-page .cyr-service-row.cyr-reverse .cyr-service-photo {\r\n  order: 2;\r\n}\r\n\r\n.cyr-services-page .cyr-service-photo {\r\n  height: 350px;\r\n  overflow: hidden;\r\n  border-radius: 13px;\r\n  border: 1px solid rgba(197,237,121,.12);\r\n}\r\n\r\n.cyr-services-page .cyr-service-photo img {\r\n  transition: transform .6s ease;\r\n}\r\n\r\n.cyr-services-page .cyr-service-photo:hover img {\r\n  transform: scale(1.045);\r\n}\r\n\r\n.cyr-services-page .cyr-service-number {\r\n  color: #C5ED79;\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  letter-spacing: 2px;\r\n  margin-bottom: 17px;\r\n}\r\n\r\n.cyr-services-page .cyr-service-copy h3 {\r\n  color: #F4F8EF;\r\n  font-size: clamp(27px, 3vw, 36px);\r\n  line-height: 1.2;\r\n  letter-spacing: -.8px;\r\n  margin: 0 0 18px;\r\n  font-weight: 700;\r\n}\r\n\r\n.cyr-services-page .cyr-service-copy p {\r\n  color: #B5C0B0;\r\n  font-size: 15px;\r\n  line-height: 1.9;\r\n  margin: 0 0 22px;\r\n}\r\n\r\n.cyr-services-page .cyr-service-copy ul {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 0;\r\n}\r\n\r\n.cyr-services-page .cyr-service-copy li {\r\n  position: relative;\r\n  color: #D5DED0;\r\n  font-size: 14px;\r\n  line-height: 1.7;\r\n  padding: 8px 0 8px 25px;\r\n}\r\n\r\n.cyr-services-page .cyr-service-copy li:before {\r\n  content: \"✓\";\r\n  position: absolute;\r\n  left: 0;\r\n  color: #C5ED79;\r\n  font-weight: 700;\r\n}\r\n\r\n/* APPROACH */\r\n.cyr-services-page .cyr-approach {\r\n  padding: 100px 0;\r\n  background:\r\n    radial-gradient(ellipse at 50% 100%, rgba(120,165,76,.12), transparent 55%),\r\n    #0B120D;\r\n}\r\n\r\n.cyr-services-page .cyr-approach-heading {\r\n  text-align: center;\r\n  margin-bottom: 55px;\r\n}\r\n\r\n.cyr-services-page .cyr-approach-heading .cyr-section-description {\r\n  margin: 0 auto;\r\n}\r\n\r\n.cyr-services-page .cyr-approach-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, 1fr);\r\n  gap: 18px;\r\n}\r\n\r\n.cyr-services-page .cyr-approach-card {\r\n  padding: 28px 23px;\r\n  background: #1A281D;\r\n  border: 1px solid rgba(197,237,121,.12);\r\n  border-radius: 11px;\r\n  min-height: 205px;\r\n}\r\n\r\n.cyr-services-page .cyr-approach-card span {\r\n  display: block;\r\n  color: #C5ED79;\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  margin-bottom: 25px;\r\n  letter-spacing: 1px;\r\n}\r\n\r\n.cyr-services-page .cyr-approach-card h4 {\r\n  color: #F4F8EF;\r\n  font-size: 18px;\r\n  font-weight: 700;\r\n  margin: 0 0 12px;\r\n}\r\n\r\n.cyr-services-page .cyr-approach-card p {\r\n  color: #B5C0B0;\r\n  font-size: 13px;\r\n  line-height: 1.8;\r\n  margin: 0;\r\n}\r\n\r\n/* CTA */\r\n.cyr-services-page .cyr-services-cta {\r\n  padding: 85px 0;\r\n  background: #111A13;\r\n}\r\n\r\n.cyr-services-page .cyr-cta-inner {\r\n  padding: 65px 35px;\r\n  text-align: center;\r\n  border-radius: 15px;\r\n  background:\r\n    radial-gradient(ellipse at 50% 0%, rgba(166,216,77,.16), transparent 65%),\r\n    #1A281D;\r\n  border: 1px solid rgba(197,237,121,.14);\r\n}\r\n\r\n.cyr-services-page .cyr-cta-inner h2 {\r\n  color: #fff;\r\n  font-size: clamp(31px, 4vw, 45px);\r\n  line-height: 1.2;\r\n  letter-spacing: -1px;\r\n  margin: 0 0 17px;\r\n}\r\n\r\n.cyr-services-page .cyr-cta-inner p {\r\n  color: #B5C0B0;\r\n  font-size: 15px;\r\n  line-height: 1.8;\r\n  max-width: 590px;\r\n  margin: 0 auto 28px;\r\n}\r\n\r\n/* FOOTER */\r\n.cyr-services-page .cyr-services-footer {\r\n  padding: 30px 0;\r\n  background: #080E09;\r\n  border-top: 1px solid rgba(197,237,121,.12);\r\n}\r\n\r\n.cyr-services-page .cyr-footer-inner {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  gap: 20px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.cyr-services-page .cyr-footer-brand {\r\n  color: #fff;\r\n  font-size: 14px;\r\n  font-weight: 700;\r\n  letter-spacing: 1px;\r\n}\r\n\r\n.cyr-services-page .cyr-footer-copy {\r\n  color: #929F8D;\r\n  font-size: 12px;\r\n  margin: 0;\r\n}\r\n\r\n/* RESPONSIVE */\r\n@media (max-width: 991px) {\r\n  .cyr-services-page .cyr-hero-grid {\r\n    gap: 40px;\r\n  }\r\n\r\n  .cyr-services-page .cyr-approach-grid {\r\n    grid-template-columns: repeat(2, 1fr);\r\n  }\r\n\r\n  .cyr-services-page .cyr-service-row {\r\n    gap: 35px;\r\n  }\r\n}\r\n\r\n@media (max-width: 767px) {\r\n  .cyr-services-page .cyr-announcement {\r\n    margin-top: 75px;\r\n    padding: 13px 12px;\r\n  }\r\n\r\n  .cyr-services-page .cyr-announcement-inner {\r\n    gap: 9px;\r\n  }\r\n\r\n  .cyr-services-page .cyr-announcement-label {\r\n    font-size: 9px;\r\n  }\r\n\r\n  .cyr-services-page .cyr-announcement-divider {\r\n    height: 15px;\r\n  }\r\n\r\n  .cyr-services-page .cyr-announcement-link {\r\n    font-size: 11px;\r\n    letter-spacing: .5px;\r\n    gap: 7px;\r\n  }\r\n\r\n  .cyr-services-page .cyr-services-hero {\r\n    padding: 75px 0 65px;\r\n  }\r\n\r\n  .cyr-services-page .cyr-hero-grid,\r\n  .cyr-services-page .cyr-service-row {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .cyr-services-page .cyr-hero-grid {\r\n    gap: 40px;\r\n  }\r\n\r\n  .cyr-services-page .cyr-hero-copy h1 {\r\n    letter-spacing: -1.8px;\r\n  }\r\n\r\n  .cyr-services-page .cyr-hero-image {\r\n    min-height: 310px;\r\n  }\r\n\r\n  .cyr-services-page .cyr-services-intro {\r\n    padding: 75px 0 45px;\r\n  }\r\n\r\n  .cyr-services-page .cyr-service-list {\r\n    padding-bottom: 65px;\r\n  }\r\n\r\n  .cyr-services-page .cyr-service-row {\r\n    padding: 45px 0;\r\n    gap: 30px;\r\n  }\r\n\r\n  .cyr-services-page .cyr-service-row.cyr-reverse .cyr-service-photo {\r\n    order: initial;\r\n  }\r\n\r\n  .cyr-services-page .cyr-service-photo {\r\n    height: 260px;\r\n  }\r\n\r\n  .cyr-services-page .cyr-approach {\r\n    padding: 75px 0;\r\n  }\r\n\r\n  .cyr-services-page .cyr-approach-grid {\r\n    gap: 12px;\r\n  }\r\n\r\n  .cyr-services-page .cyr-approach-card {\r\n    padding: 22px 17px;\r\n    min-height: 190px;\r\n  }\r\n\r\n  .cyr-services-page .cyr-services-cta {\r\n    padding: 60px 0;\r\n  }\r\n\r\n  .cyr-services-page .cyr-cta-inner {\r\n    padding: 48px 22px;\r\n  }\r\n}\r\n\r\n@media (max-width: 420px) {\r\n  .cyr-services-page .cyr-approach-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .cyr-services-page .cyr-hero-actions {\r\n    align-items: flex-start;\r\n    flex-direction: column;\r\n    gap: 18px;\r\n  }\r\n}\r\n</style>\r\n\r\n<div class=\"cyr-services-page\">\r\n\r\n  <!-- ANNOUNCEMENT -->\r\n  <section class=\"cyr-announcement\">\r\n    <div class=\"cyr-announcement-inner\">\r\n      <span class=\"cyr-announcement-label\">SPECIAL ANNOUNCEMENT</span>\r\n      <span class=\"cyr-announcement-divider\"></span>\r\n      <a href=\"digital-radio.html\" class=\"cyr-announcement-link\">\r\n        DIGITAL RADIO AT AFFORDABLE PRICE\r\n        <span>↗</span>\r\n      </a>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- HERO -->\r\n  <section data-bs-version=\"5.1\" class=\"cyr-services-hero\">\r\n    <div class=\"cyr-container\">\r\n      <div class=\"cyr-hero-grid\">\r\n\r\n        <div class=\"cyr-hero-copy\">\r\n          <div class=\"cyr-eyebrow\">What We Do</div>\r\n\r\n          <h1>\r\n            Digital solutions built around <span>your business.</span>\r\n          </h1>\r\n\r\n          <p>\r\n            From creating your online presence to building and managing the databases behind your operations, we provide practical digital solutions designed around your needs.\r\n          </p>\r\n\r\n          <div class=\"cyr-hero-actions\">\r\n            <a href=\"contact.html\" class=\"cyr-primary-btn\">Explore Our Services</a>\r\n            <a href=\"contact.html\" class=\"cyr-text-link\">Discuss a Project →</a>\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"cyr-hero-image\">\r\n          <img src=\"https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=1100&q=85\" alt=\"Digital workspace displaying website and business data analytics\">\r\n\r\n          <div class=\"cyr-image-caption\">\r\n            <strong>Thoughtful digital solutions</strong>\r\n            <span>Design. Development. Data.</span>\r\n          </div>\r\n        </div>\r\n\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- INTRODUCTION -->\r\n  <section class=\"cyr-services-intro\">\r\n    <div class=\"cyr-container\">\r\n      <div class=\"cyr-eyebrow\">Our Expertise</div>\r\n\r\n      <h2 class=\"cyr-section-heading\">\r\n        The right digital foundation<br>starts here.\r\n      </h2>\r\n\r\n      <p class=\"cyr-section-description\">\r\n        Every business has different needs. That is why our services focus on creating useful, well-structured digital solutions that help businesses establish their presence, improve their processes and organise their information.\r\n      </p>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- SERVICE DETAILS -->\r\n  <section class=\"cyr-service-list\" id=\"cyr-service-details\">\r\n    <div class=\"cyr-container\">\r\n\r\n      <!-- WEBSITE DESIGN -->\r\n      <div class=\"cyr-service-row\">\r\n        <div class=\"cyr-service-photo\">\r\n          <img src=\"https://images.unsplash.com/photo-1547658719-da2b51169166?auto=format&fit=crop&w=1000&q=85\" alt=\"Website layout and interface design displayed on a computer\">\r\n        </div>\r\n\r\n        <div class=\"cyr-service-copy\">\r\n          <div class=\"cyr-service-number\">01 / WEBSITE DESIGN</div>\r\n\r\n          <h3>Websites that make a strong first impression.</h3>\r\n\r\n          <p>\r\n            Your website is often one of the first ways people interact with your business. We focus on creating clean, professional and user-friendly website designs that communicate your brand clearly and make information easy to find.\r\n          </p>\r\n\r\n          <ul>\r\n            <li>Professional website layouts</li>\r\n            <li>Responsive designs for different screen sizes</li>\r\n            <li>Clear navigation and content presentation</li>\r\n            <li>Designs tailored to your business identity</li>\r\n          </ul>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- WEB DEVELOPMENT -->\r\n      <div class=\"cyr-service-row cyr-reverse\">\r\n        <div class=\"cyr-service-photo\">\r\n          <img src=\"https://images.unsplash.com/photo-1461749280684-dccba630e2f6?auto=format&fit=crop&w=1000&q=85\" alt=\"Code displayed on a computer screen during web development\">\r\n        </div>\r\n\r\n        <div class=\"cyr-service-copy\">\r\n          <div class=\"cyr-service-number\">02 / WEB DEVELOPMENT</div>\r\n\r\n          <h3>Turning ideas into functional websites.</h3>\r\n\r\n          <p>\r\n            Good design needs reliable development behind it. We build websites by bringing structure, functionality and design together to create experiences that work across modern devices and browsers.\r\n          </p>\r\n\r\n          <ul>\r\n            <li>Website development and implementation</li>\r\n            <li>Functional website features</li>\r\n            <li>Responsive and browser-friendly development</li>\r\n            <li>Website updates and improvements</li>\r\n          </ul>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- DATABASE CREATION -->\r\n      <div class=\"cyr-service-row\">\r\n        <div class=\"cyr-service-photo\">\r\n          <img src=\"https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=1000&q=85\" alt=\"Server infrastructure representing structured data systems\">\r\n        </div>\r\n\r\n        <div class=\"cyr-service-copy\">\r\n          <div class=\"cyr-service-number\">03 / DATABASE CREATION</div>\r\n\r\n          <h3>Well-structured databases for your information.</h3>\r\n\r\n          <p>\r\n            Business information needs a proper structure. We create databases designed to organise records, support information retrieval and provide a dependable foundation for applications and business processes.\r\n          </p>\r\n\r\n          <ul>\r\n            <li>Database design and structure</li>\r\n            <li>Organised data storage systems</li>\r\n            <li>Database creation for business applications</li>\r\n            <li>Structured information management solutions</li>\r\n          </ul>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- DATABASE MANAGEMENT -->\r\n      <div class=\"cyr-service-row cyr-reverse\">\r\n        <div class=\"cyr-service-photo\">\r\n          <img src=\"https://images.unsplash.com/photo-1518186233392-c232efbf2373?auto=format&fit=crop&w=1000&q=85\" alt=\"Data visualisation and information management on a computer\">\r\n        </div>\r\n\r\n        <div class=\"cyr-service-copy\">\r\n          <div class=\"cyr-service-number\">04 / DATABASE MANAGEMENT</div>\r\n\r\n          <h3>Keeping your business data organised.</h3>\r\n\r\n          <p>\r\n            Creating a database is only one part of the process. Proper management helps keep information organised, accessible and useful. We focus on database organisation and management based on the requirements of each system.\r\n          </p>\r\n\r\n          <ul>\r\n            <li>Database organisation and maintenance</li>\r\n            <li>Data updates and record management</li>\r\n            <li>Database structure improvements</li>\r\n            <li>Support for organised information systems</li>\r\n          </ul>\r\n        </div>\r\n      </div>\r\n\r\n    </div>\r\n  </section>\r\n\r\n  <!-- OUR APPROACH -->\r\n  <section class=\"cyr-approach\">\r\n    <div class=\"cyr-container\">\r\n\r\n      <div class=\"cyr-approach-heading\">\r\n        <div class=\"cyr-eyebrow\">How We Work</div>\r\n\r\n        <h2 class=\"cyr-section-heading\">\r\n          A clear approach from<br>idea to delivery.\r\n        </h2>\r\n\r\n        <p class=\"cyr-section-description\">\r\n          We keep the process straightforward, focusing on understanding what you need and developing a solution that addresses it.\r\n        </p>\r\n      </div>\r\n\r\n      <div class=\"cyr-approach-grid\">\r\n\r\n        <div class=\"cyr-approach-card\">\r\n          <span>01</span>\r\n          <h4>Understand</h4>\r\n          <p>We learn about your business, your requirements and the problem you want to solve.</p>\r\n        </div>\r\n\r\n        <div class=\"cyr-approach-card\">\r\n          <span>02</span>\r\n          <h4>Plan</h4>\r\n          <p>We determine the structure, direction and features required for the project.</p>\r\n        </div>\r\n\r\n        <div class=\"cyr-approach-card\">\r\n          <span>03</span>\r\n          <h4>Develop</h4>\r\n          <p>We bring the solution together with attention to its design, functionality and structure.</p>\r\n        </div>\r\n\r\n        <div class=\"cyr-approach-card\">\r\n          <span>04</span>\r\n          <h4>Deliver</h4>\r\n          <p>We present the completed work and ensure it aligns with the agreed requirements.</p>\r\n        </div>\r\n\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- CONTACT CTA -->\r\n  <section class=\"cyr-services-cta\" id=\"cyr-service-contact\">\r\n    <div class=\"cyr-container\">\r\n      <div class=\"cyr-cta-inner\">\r\n\r\n        <div class=\"cyr-eyebrow\">Let's Work Together</div>\r\n\r\n        <h2>Have a project in mind?</h2>\r\n\r\n        <p>\r\n          Whether you need a professional website, a functional web solution or a well-organised database, let's discuss what you have in mind.\r\n        </p>\r\n\r\n        <a href=\"mailto:forwisdomswork@gmail.com\" class=\"cyr-primary-btn\">\r\n          Start a Conversation →\r\n        </a>\r\n\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- FOOTER -->\r\n  <footer class=\"cyr-services-footer\">\r\n    <div class=\"cyr-container\">\r\n      <div class=\"cyr-footer-inner\">\r\n\r\n        <div class=\"cyr-footer-brand\">\r\n          CY ROBINSON TECHNOLOGIES\r\n        </div>\r\n\r\n        <p class=\"cyr-footer-copy\">\r\n          © 2026 CY Robinson Technologies. All rights reserved.\r\n        </p>\r\n\r\n      </div>\r\n    </div>\r\n  </footer>\r\n\r\n</div>\r\n```\r\n\r\n",
