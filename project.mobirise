          "_name": "header09",
          "_sourceTheme": "startm5",
          "_customHTML": "```html\n<style>\n.cyr-faq-page {\n  --bg: #0B120D;\n  --panel: #111A13;\n  --panel-light: #1A281D;\n  --text: #F4F7F1;\n  --muted: #B5C0B0;\n  --accent: #B7E65C;\n  --border: rgba(197,237,121,.12);\n  font-family: Arial, sans-serif;\n  color: var(--text);\n  background: var(--bg);\n  overflow: hidden;\n}\n\n.cyr-faq-page * {\n  box-sizing: border-box;\n}\n\n/* ANNOUNCEMENT */\n.cyr-faq-page .cyr-announcement {\n  margin-top: 90px;\n  padding: 15px 20px;\n  background:\n    linear-gradient(100deg,rgba(183,230,92,.10),rgba(85,145,72,.08)),\n    #0D170F;\n  border-top: 1px solid rgba(183,230,92,.20);\n  border-bottom: 1px solid rgba(183,230,92,.20);\n}\n\n.cyr-faq-page .cyr-announcement-inner {\n  width: min(1160px,90%);\n  margin: auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 18px;\n  flex-wrap: wrap;\n}\n\n.cyr-faq-page .cyr-announcement-label {\n  color: #C5ED79;\n  font-size: 10px;\n  font-weight: 800;\n  letter-spacing: 2px;\n}\n\n.cyr-faq-page .cyr-announcement-divider {\n  width: 1px;\n  height: 19px;\n  background: rgba(255,255,255,.25);\n}\n\n.cyr-faq-page .cyr-announcement-link {\n  display: inline-flex;\n  align-items: center;\n  gap: 12px;\n  color: #F4F7F1 !important;\n  font-size: 13px;\n  font-weight: 750;\n  letter-spacing: 1.1px;\n  text-decoration: none !important;\n  transition: .25s ease;\n}\n\n.cyr-faq-page .cyr-announcement-link span {\n  color: #B7E65C;\n  font-size: 19px;\n  transition: transform .25s ease;\n}\n\n.cyr-faq-page .cyr-announcement-link:hover {\n  color: #D0EF78 !important;\n}\n\n.cyr-faq-page .cyr-announcement-link:hover span {\n  transform: translate(3px,-3px);\n}\n\n/* HERO */\n.cyr-faq-page .cyr-faq-hero {\n  padding: 105px 7% 75px;\n  text-align: center;\n  background:\n    radial-gradient(ellipse at 50% 0%, rgba(143,198,90,.16), transparent 55%),\n    linear-gradient(135deg, #0D170F, #0B120D);\n}\n\n.cyr-faq-page .cyr-eyebrow {\n  color: #C5ED79;\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 3px;\n  margin-bottom: 20px;\n}\n\n.cyr-faq-page .cyr-faq-hero h1 {\n  color: #fff !important;\n  font-size: clamp(38px, 6vw, 64px);\n  line-height: 1.12;\n  font-weight: 700;\n  max-width: 850px;\n  margin: 0 auto 20px;\n}\n\n.cyr-faq-page .cyr-faq-hero p {\n  color: #B5C0B0 !important;\n  font-size: 16px;\n  line-height: 1.8;\n  max-width: 620px;\n  margin: auto;\n}\n\n/* FAQ CONTENT */\n.cyr-faq-page .cyr-faq-content {\n  max-width: 1000px;\n  margin: auto;\n  padding: 75px 25px 100px;\n}\n\n.cyr-faq-page .cyr-faq-heading {\n  margin-bottom: 28px;\n}\n\n.cyr-faq-page .cyr-faq-heading h2 {\n  color: #fff !important;\n  font-size: 27px;\n  margin: 0 0 10px;\n}\n\n.cyr-faq-page .cyr-faq-heading p {\n  color: var(--muted) !important;\n  line-height: 1.7;\n  margin: 0;\n}\n\n.cyr-faq-page .cyr-faq-list {\n  display: grid;\n  gap: 13px;\n  margin-bottom: 55px;\n}\n\n.cyr-faq-page details {\n  background: var(--panel);\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  overflow: hidden;\n  transition: background .25s ease, border-color .25s ease;\n}\n\n.cyr-faq-page details[open] {\n  background: var(--panel-light);\n  border-color: rgba(183,230,92,.45);\n}\n\n.cyr-faq-page summary {\n  list-style: none;\n  cursor: pointer;\n  padding: 22px 24px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n  color: #F4F7F1 !important;\n  font-size: 16px;\n  font-weight: 600;\n  line-height: 1.5;\n}\n\n.cyr-faq-page summary::-webkit-details-marker {\n  display: none;\n}\n\n.cyr-faq-page summary::after {\n  content: \"+\";\n  flex-shrink: 0;\n  color: #B7E65C;\n  font-size: 25px;\n  font-weight: 400;\n}\n\n.cyr-faq-page details[open] summary::after {\n  content: \"−\";\n}\n\n.cyr-faq-page .cyr-faq-answer {\n  padding: 0 24px 22px;\n  color: #B5C0B0 !important;\n  font-size: 14px;\n  line-height: 1.85;\n}\n\n.cyr-faq-page .cyr-faq-answer a {\n  color: #C5ED79;\n  text-decoration: none;\n}\n\n.cyr-faq-page .cyr-faq-answer a:hover {\n  color: #D8F29B;\n  text-decoration: underline;\n}\n\n/* CTA */\n.cyr-faq-page .cyr-faq-cta {\n  text-align: center;\n  padding: 55px 25px;\n  border-radius: 18px;\n  background:\n    radial-gradient(ellipse at 100% 0%, rgba(143,198,90,.17), transparent 55%),\n    #111A13;\n  border: 1px solid var(--border);\n}\n\n.cyr-faq-page .cyr-faq-cta h2 {\n  color: #fff !important;\n  font-size: clamp(25px, 4vw, 36px);\n  margin: 0 0 14px;\n}\n\n.cyr-faq-page .cyr-faq-cta p {\n  color: #B5C0B0 !important;\n  line-height: 1.8;\n  max-width: 570px;\n  margin: 0 auto 25px;\n}\n\n.cyr-faq-page .cyr-faq-button {\n  display: inline-block;\n  padding: 15px 27px;\n  border-radius: 7px;\n  background: linear-gradient(110deg, #A6D84D, #D0EF78);\n  color: #14200F !important;\n  font-size: 14px;\n  font-weight: 700;\n  text-decoration: none !important;\n  transition: transform .25s ease, box-shadow .25s ease;\n}\n\n.cyr-faq-page .cyr-faq-button:hover {\n  transform: translateY(-3px);\n  box-shadow: 0 10px 30px rgba(183,230,92,.20);\n}\n\n/* FOOTER */\n.cyr-faq-page .cyr-faq-footer {\n  border-top: 1px solid var(--border);\n  padding: 25px 7%;\n  text-align: center;\n  color: #849080 !important;\n  font-size: 12px;\n}\n\n/* MOBILE */\n@media(max-width:600px) {\n  .cyr-faq-page .cyr-announcement {\n    margin-top: 75px;\n    padding: 13px 12px;\n  }\n\n  .cyr-faq-page .cyr-announcement-inner {\n    gap: 9px;\n  }\n\n  .cyr-faq-page .cyr-announcement-label {\n    font-size: 9px;\n  }\n\n  .cyr-faq-page .cyr-announcement-divider {\n    height: 15px;\n  }\n\n  .cyr-faq-page .cyr-announcement-link {\n    font-size: 11px;\n    letter-spacing: .5px;\n    gap: 7px;\n  }\n\n  .cyr-faq-page .cyr-faq-hero {\n    padding: 85px 22px 60px;\n  }\n\n  .cyr-faq-page .cyr-faq-content {\n    padding: 55px 18px 70px;\n  }\n\n  .cyr-faq-page summary {\n    padding: 19px;\n    font-size: 14px;\n  }\n\n  .cyr-faq-page .cyr-faq-answer {\n    padding: 0 19px 19px;\n  }\n\n  .cyr-faq-page .cyr-faq-cta {\n    padding: 40px 20px;\n  }\n}\n</style>\n\n<div class=\"cyr-faq-page\">\n\n  <!-- ANNOUNCEMENT -->\n  <section class=\"cyr-announcement\">\n    <div class=\"cyr-announcement-inner\">\n      <span class=\"cyr-announcement-label\">SPECIAL ANNOUNCEMENT</span>\n      <span class=\"cyr-announcement-divider\"></span>\n      <a href=\"digital-radio.html\" class=\"cyr-announcement-link\">\n        DIGITAL RADIO AT AFFORDABLE PRICE\n        <span>↗</span>\n      </a>\n    </div>\n  </section>\n\n  <!-- HERO -->\n  <section data-bs-version=\"5.1\" class=\"cyr-faq-hero\">\n    <div class=\"cyr-eyebrow\">FREQUENTLY ASKED QUESTIONS</div>\n    <h1>Questions? We've got answers.</h1>\n    <p>\n      Find answers to common questions about our services,\n      how we work, and how to get started with your next project.\n    </p>\n  </section>\n\n  <main class=\"cyr-faq-content\">\n\n    <div class=\"cyr-faq-heading\">\n      <h2>General Questions</h2>\n      <p>Learn more about CY Robinson Technologies and what we do.</p>\n    </div>\n\n    <div class=\"cyr-faq-list\">\n\n      <details>\n        <summary>What does CY Robinson Technologies do?</summary>\n        <div class=\"cyr-faq-answer\">\n          CY Robinson Technologies focuses on website design,\n          web development, database creation, and database management.\n          We aim to provide practical digital solutions based on\n          each project's requirements.\n        </div>\n      </details>\n\n      <details>\n        <summary>What services do you offer?</summary>\n        <div class=\"cyr-faq-answer\">\n          Our services cover four main areas: website design,\n          web development, database creation, and database management.\n          You can visit our Services page to learn more about each one.\n        </div>\n      </details>\n\n      <details>\n        <summary>How do I get started?</summary>\n        <div class=\"cyr-faq-answer\">\n          Start by contacting us through the Contact page.\n          Describe your idea, the problem you want to solve,\n          or the service you need. We can then discuss the\n          project requirements and possible next steps.\n        </div>\n      </details>\n\n      <details>\n        <summary>How can I request a quotation?</summary>\n        <div class=\"cyr-faq-answer\">\n          Send us a message through the contact form with a\n          description of your project. The information you provide\n          will help us understand what you need before discussing\n          the project cost.\n        </div>\n      </details>\n\n    </div>\n\n    <div class=\"cyr-faq-heading\">\n      <h2>Our Services</h2>\n      <p>Answers about the digital solutions we provide.</p>\n    </div>\n\n    <div class=\"cyr-faq-list\">\n\n      <details>\n        <summary>Do you design websites for businesses?</summary>\n        <div class=\"cyr-faq-answer\">\n          Yes. Website design is one of our core services.\n          We work on website layouts, visual presentation,\n          navigation, and responsive design based on the\n          needs of the business.\n        </div>\n      </details>\n\n      <details>\n        <summary>What is the difference between website design and web development?</summary>\n        <div class=\"cyr-faq-answer\">\n          Website design focuses on how a website looks and how\n          visitors interact with it. Web development focuses on\n          building the functionality that makes the website work.\n          Both areas can contribute to a complete website.\n        </div>\n      </details>\n\n      <details>\n        <summary>Can you create a database for my business?</summary>\n        <div class=\"cyr-faq-answer\">\n          We offer database creation for organizing and storing\n          information. The structure and features depend on the\n          type of information your business needs to manage.\n        </div>\n      </details>\n\n      <details>\n        <summary>What does database management involve?</summary>\n        <div class=\"cyr-faq-answer\">\n          Database management involves maintaining and organizing\n          stored information, helping keep data structured,\n          accessible, and useful for its intended purpose.\n        </div>\n      </details>\n\n      <details>\n        <summary>Can I request changes to my project?</summary>\n        <div class=\"cyr-faq-answer\">\n          Project changes can be discussed during the project.\n          The requested changes, their scope, and any effect on\n          the agreed requirements or cost should be clarified\n          before additional work begins.\n        </div>\n      </details>\n\n    </div>\n\n    <div class=\"cyr-faq-heading\">\n      <h2>Projects and Communication</h2>\n      <p>What to expect when discussing a project with us.</p>\n    </div>\n\n    <div class=\"cyr-faq-list\">\n\n      <details>\n        <summary>How long does a project take?</summary>\n        <div class=\"cyr-faq-answer\">\n          Project timelines depend on the size, features,\n          requirements, and complexity of the work.\n          A timeline can be discussed once we understand\n          the details of your project.\n        </div>\n      </details>\n\n      <details>\n        <summary>What information should I provide before starting?</summary>\n        <div class=\"cyr-faq-answer\">\n          It helps to provide a description of what you want,\n          the purpose of the project, the features you need,\n          and any relevant examples or references.\n          You do not need to have every detail figured out\n          before making an enquiry.\n        </div>\n      </details>\n\n      <details>\n        <summary>How can I contact CY Robinson Technologies?</summary>\n        <div class=\"cyr-faq-answer\">\n          You can reach us through the Contact page or send\n          an email to\n          <a href=\"mailto:forwisdomswork@gmail.com\">forwisdomswork@gmail.com</a>.\n        </div>\n      </details>\n\n    </div>\n\n    <!-- CONTACT CTA -->\n    <section class=\"cyr-faq-cta\">\n      <h2>Still have a question?</h2>\n      <p>\n        If you need more information or would like to discuss\n        a project, get in touch with us.\n      </p>\n      <a class=\"cyr-faq-button\" href=\"contact.html\">\n        Contact Us →\n      </a>\n    </section>\n\n  </main>\n\n  <!-- FOOTER -->\n  <footer class=\"cyr-faq-footer\">\n    © 2026 CY Robinson Technologies. All rights reserved.\n  </footer>\n\n</div>\n```",
          "_isUserblock": true,
          "_cid": "vzVhIUB4NX",
          "_anchor": "header09-b",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        }
      ]
    },
    "index.html": {
      "settings": {
        "main": true,
        "title": "Home",
