        },
        {
          "alias": false,
          "_styles": {},
          "_name": "header18",
          "_sourceTheme": "startm5",
          "_customHTML": "```html\r\n<div style=\"\r\n    width: 100%;\r\n    background: #11182B;\r\n    padding: 13px 15px;\r\n    text-align: center;\r\n    box-sizing: border-box;\r\n    border-bottom: 1px solid rgba(139, 125, 255, 0.25);\r\n\">\r\n    <a href=\"digital-radio.html\" style=\"\r\n        display: inline-flex;\r\n        align-items: center;\r\n        justify-content: center;\r\n        gap: 12px;\r\n        color: #FFFFFF;\r\n        text-decoration: none;\r\n        font-family: Arial, sans-serif;\r\n        font-size: 13px;\r\n        font-weight: 700;\r\n        letter-spacing: 1.5px;\r\n    \">\r\n        DIGITAL RADIO AT AFFORDABLE PRICE\r\n        <span style=\"color: #A99AFF; font-size: 19px;\">→</span>\r\n    </a>\r\n</div>\r\n```",
